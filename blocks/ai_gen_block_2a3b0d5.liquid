{% doc %}
  @prompt
    create this same custom section with responsive
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.mobile_padding }}px {{ block.settings.mobile_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-responsive-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-responsive-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.mobile_gap }}px;
    align-items: {{ block.settings.mobile_alignment }};
  }

  .ai-responsive-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.mobile_image_first %}
      order: 1;
    {% else %}
      order: 2;
    {% endif %}
  }

  .ai-responsive-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-responsive-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-responsive-text-wrapper-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.mobile_image_first %}
      order: 2;
    {% else %}
      order: 1;
    {% endif %}
  }

  .ai-responsive-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.mobile_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.mobile_gap | divided_by: 2 }}px;
    line-height: 1.2;
  }

  .ai-responsive-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.mobile_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.mobile_gap }}px;
  }

  .ai-responsive-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.mobile_button_padding }}px {{ block.settings.mobile_button_padding | times: 2 }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.mobile_button_text_size }}px;
    transition: background-color 0.3s ease;
    text-align: center;
    border: none;
    cursor: pointer;
  }

  .ai-responsive-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-responsive-section-{{ ai_gen_id }} {
      padding: {{ block.settings.tablet_padding }}px {{ block.settings.tablet_padding }}px;
    }

    .ai-responsive-content-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.tablet_layout }};
      gap: {{ block.settings.tablet_gap }}px;
      align-items: {{ block.settings.tablet_alignment }};
    }

    .ai-responsive-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.tablet_image_width }}%;
      order: 0;
    }

    .ai-responsive-text-wrapper-{{ ai_gen_id }} {
      width: {{ 100 | minus: block.settings.tablet_image_width }}%;
      order: 0;
    }

    .ai-responsive-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.tablet_heading_size }}px;
      margin-bottom: {{ block.settings.tablet_gap | divided_by: 2 }}px;
    }

    .ai-responsive-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.tablet_text_size }}px;
      margin-bottom: {{ block.settings.tablet_gap }}px;
    }

    .ai-responsive-button-{{ ai_gen_id }} {
      padding: {{ block.settings.tablet_button_padding }}px {{ block.settings.tablet_button_padding | times: 2 }}px;
      font-size: {{ block.settings.tablet_button_text_size }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-responsive-section-{{ ai_gen_id }} {
      padding: {{ block.settings.desktop_padding }}px {{ block.settings.desktop_padding }}px;
    }

    .ai-responsive-content-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.desktop_layout }};
      gap: {{ block.settings.desktop_gap }}px;
      align-items: {{ block.settings.desktop_alignment }};
    }

    .ai-responsive-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_image_width }}%;
    }

    .ai-responsive-text-wrapper-{{ ai_gen_id }} {
      width: {{ 100 | minus: block.settings.desktop_image_width }}%;
    }

    .ai-responsive-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_heading_size }}px;
      margin-bottom: {{ block.settings.desktop_gap | divided_by: 2 }}px;
    }

    .ai-responsive-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_text_size }}px;
      margin-bottom: {{ block.settings.desktop_gap }}px;
    }

    .ai-responsive-button-{{ ai_gen_id }} {
      padding: {{ block.settings.desktop_button_padding }}px {{ block.settings.desktop_button_padding | times: 2 }}px;
      font-size: {{ block.settings.desktop_button_text_size }}px;
    }
  }
{% endstyle %}

<responsive-section-{{ ai_gen_id }} class="ai-responsive-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-responsive-container-{{ ai_gen_id }}">
    <div class="ai-responsive-content-{{ ai_gen_id }}">
      <div class="ai-responsive-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-responsive-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-responsive-empty-state-{{ ai_gen_id }}">
              Add an image to get started
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-responsive-text-wrapper-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-responsive-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-responsive-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a
            href="{{ block.settings.button_link }}"
            class="ai-responsive-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</responsive-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ResponsiveSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupResponsive();
        window.addEventListener('resize', this.handleResize.bind(this));
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.handleResize.bind(this));
      }

      setupResponsive() {
        this.updateLayout();
      }

      handleResize() {
        this.updateLayout();
      }

      updateLayout() {
        const width = window.innerWidth;
        const content = this.querySelector('.ai-responsive-content-{{ ai_gen_id }}');
        
        if (width < 750) {
          content.setAttribute('data-viewport', 'mobile');
        } else if (width < 990) {
          content.setAttribute('data-viewport', 'tablet');
        } else {
          content.setAttribute('data-viewport', 'desktop');
        }
      }
    }

    customElements.define('responsive-section-{{ ai_gen_id }}', ResponsiveSection{{ ai_gen_id }});
  })();
</script>

