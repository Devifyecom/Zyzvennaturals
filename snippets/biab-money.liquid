{%- comment -%}
  Business in a Box: one approved figure, always shown in USD.

  Every price on the Business in a Box page comes from the approved USD figures
  (the $999 box and the agreed RRPs). They are shown exactly as approved, e.g.
  $999.00 and $2,029.60, whatever market or currency the shopper is browsing in,
  so the headline, product cards and purchase panel never show competing figures.

  Accepts:
  - amount: approved USD amount, e.g. '69.99', '$2,029.60' or 999
  - cents: approved USD amount in cents (used instead of amount)
  - box: true to output the approved box price
  - raw: true to output cents instead of formatted money

  Usage:
  {% render 'biab-money', amount: '69.99' %}
  {% capture box_cents %}{% render 'biab-money', box: true, raw: true %}{% endcapture %}
{%- endcomment -%}

{%- liquid
  assign approved_box_cents = 99900

  if box
    assign out_cents = approved_box_cents
  elsif cents != blank
    assign out_cents = cents | round
  else
    assign out_cents = amount | append: '' | remove: '$' | remove: ',' | strip | times: 100 | round
  endif

  if raw
    echo out_cents
  else
    comment
      Format as $1,234.56 without the store's currency format, which follows the shopper's market
    endcomment
    assign dollars = out_cents | divided_by: 100
    assign cents_part = out_cents | modulo: 100 | prepend: '0' | slice: -2, 2
    if dollars >= 1000
      assign thousands = dollars | divided_by: 1000
      assign hundreds = dollars | modulo: 1000 | prepend: '00' | slice: -3, 3
      assign dollars_str = thousands | append: ',' | append: hundreds
    else
      assign dollars_str = dollars | append: ''
    endif
    echo '$' | append: dollars_str | append: '.' | append: cents_part
  endif
-%}
