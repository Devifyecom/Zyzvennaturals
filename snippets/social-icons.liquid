            <path d="M11.7231 0H8.57719V12.942C8.57719 14.4841 7.36726 15.7507 5.86154 15.7507C4.35582 15.7507 3.14587 14.4841 3.14587 12.942C3.14587 11.4276 4.32893 10.1884 5.78089 10.1333V6.88407C2.58123 6.93912 0 9.61015 0 12.942C0 16.3015 2.635 19 5.88844 19C9.14182 19 11.7768 16.2739 11.7768 12.942V6.30578C12.9599 7.18696 14.4118 7.71015 15.9444 7.7377V4.48841C13.5783 4.4058 11.7231 2.42319 11.7231 0Z" fill="white"/>
          </svg>
        </span>
        <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_twitter_link != blank -%}
    <li class="list-social__item">
      <a href="{{ settings.social_twitter_link }}" class="link list-social__link">
        <span class="svg-wrapper">
          {{- 'icon-twitter.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}
