    },
    { "type": "checkbox", "id": "mobile_row_layout", "label": "Mobile: number beside text", "info": "Off keeps cards centered and stacked.", "default": true },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1500, "step": 20, "unit": "px", "default": 1160 },
    { "type": "range", "id": "gap", "label": "Gap between cards", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 26, "max": 52, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
