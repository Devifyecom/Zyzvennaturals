{%- liquid
  assign fade = section.settings.edge_fade_color
  assign has_desktop = false
  if section.settings.image != blank
    assign has_desktop = true
  endif
-%}

<style>
  #BalanceBanner-{{ section.id }} {
    --bb-fade: {{ fade }};
    --bb-fade-w: {{ section.settings.edge_fade_width }}%;
    --bb-heading: {{ section.settings.heading_color }};
    position: relative;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-bottom: {{ section.settings.margin_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    background: {{ section.settings.background_color }};
    line-height: 0;
    overflow: hidden;
  }

  #BalanceBanner-{{ section.id }} * { box-sizing: border-box; }

  .bb__media {
    position: relative;
    display: block;
    width: 100%;
  }

  .bb__img {
    display: block;
    width: 100%;
    height: auto;
    {% if section.settings.image != blank %}
      aspect-ratio: {{ section.settings.image.aspect_ratio | default: 1.36 }};
    {% endif %}
    object-fit: cover;
  }

  .bb__img--mobile { display: none; }

  /* Edge fade ‚Äî feathers the banner into the page background on both sides */
  .bb__fade {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    background: linear-gradient(
      to right,
      {{ fade }} 0%,
      {{ fade | color_modify: 'alpha', 0 }} var(--bb-fade-w),
      {{ fade | color_modify: 'alpha', 0 }} calc(100% - var(--bb-fade-w)),
      {{ fade }} 100%
    );
  }

  {%- if section.settings.fade_bottom -%}
  .bb__fade--y {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      {{ fade | color_modify: 'alpha', 0 }} 78%,
      {{ fade }} 100%
    );
  }
  {%- endif -%}

  /* ---------- Overlay text (live, selectable, translatable) ---------- */
  .bb__overlay {
    position: absolute;
    inset: 0;
    line-height: normal;
    pointer-events: none;
  }

  .bb__heading {
    position: absolute;
    left: 50%;
    top: {{ section.settings.heading_top }}%;
    transform: translateX(-50%);
    width: min(72%, 1100px);
    margin: 0;
    text-align: center;
    color: var(--bb-heading);
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-style: {{ section.settings.heading_font.style }};
    font-weight: {{ section.settings.heading_font.weight }};
    font-size: clamp(24px, {{ section.settings.heading_size }}vw, 92px);
    line-height: 1.06;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  /* ---------- Benefit pills ---------- */
  .bb__pills {
    position: absolute;
    left: {{ section.settings.pills_left }}%;
    top: {{ section.settings.pills_top }}%;
    width: {{ section.settings.pills_width }}%;
    display: flex;
    flex-direction: column;
    gap: 0.9%;
    pointer-events: auto;
  }

  .bb__pill {
    display: flex;
    align-items: center;
    gap: 1.1em;
    padding: 0.62em 1.1em;
    border-radius: 0.62em;
    color: #fff;
    font-size: clamp(11px, 1.42vw, 26px);
    font-weight: 800;
    letter-spacing: .01em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.1;
    /* solid bottom edge = the stacked, extruded look in the reference */
    box-shadow: 0 0.22em 0 rgba(0, 0, 0, .17), 0 0.5em 1em rgba(0, 0, 0, .08);
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
  }

  a.bb__pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.32em 0 rgba(0, 0, 0, .17), 0 0.7em 1.2em rgba(0, 0, 0, .12);
    filter: saturate(1.06);
  }

  a.bb__pill:active { transform: translateY(1px); }
  a.bb__pill:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

  .bb__pill-icon {
    flex: 0 0 auto;
    width: 1.55em;
    height: 1.55em;
    display: block;
  }

  .bb__pill-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Responsive ---------- */
  @media screen and (max-width: 989px) {
    .bb__heading { width: 86%; }
    .bb__pill { gap: .8em; padding: .55em .8em; border-radius: .55em; }
  }

  @media screen and (max-width: 749px) {
    {%- if section.settings.image_mobile != blank -%}
      .bb__img--desktop { display: none; }
      .bb__img--mobile {
        display: block;
        aspect-ratio: {{ section.settings.image_mobile.aspect_ratio | default: 0.9 }};
      }
    {%- endif -%}

    #BalanceBanner-{{ section.id }} { --bb-fade-w: {{ section.settings.edge_fade_width | divided_by: 2 }}%; }

    {%- if section.settings.stack_on_mobile -%}
      .bb__pills {
        position: static;
        width: auto;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        padding: 16px 18px 22px;
      }

      .bb__pill {
        font-size: 13px;
        padding: 12px 14px;
        border-radius: 12px;
        gap: 10px;
      }

      .bb__overlay { position: absolute; inset: 0; }
      .bb__pills-wrap { position: relative; background: {{ section.settings.background_color }}; }
    {%- endif -%}
  }

  @media (prefers-reduced-motion: reduce) {
    .bb__pill { transition: none; }
  }
</style>

{%- capture icon_lotus -%}
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4c1.9 1.7 2.9 3.7 2.9 6S13.9 14.3 12 16c-1.9-1.7-2.9-3.7-2.9-6S10.1 5.7 12 4Z"/><path d="M12 16c-2.5 0-4.6-.9-6.3-2.6-1.2-1.2-2-2.6-2.4-4.2 1.8-.3 3.4 0 4.9.9"/><path d="M12 16c2.5 0 4.6-.9 6.3-2.6 1.2-1.2 2-2.6 2.4-4.2-1.8-.3-3.4 0-4.9.9"/><path d="M3.4 13.6c1.3 3.3 4.3 5.4 8.6 5.4s7.3-2.1 8.6-5.4"/></svg>
{%- endcapture -%}

{%- capture icon_uterus -%}
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v3.2c0 3.1.6 5 1.6 6.3.9 1.2 1.4 2.3 1.4 3.6V20"/><path d="M15 4v3.2c0 3.1-.6 5-1.6 6.3"/><path d="M9 7.2c-1.7.2-3 .9-3.9 2-1 1.3-1.4 3-1.1 4.6"/><path d="M15 7.2c1.7.2 3 .9 3.9 2 1 1.3 1.4 3 1.1 4.6"/><path d="M7.5 4h3M13.5 4h3"/><path d="M4 13.8c.6 1.2 1.6 2 3 2.3M20 13.8c-.6 1.2-1.6 2-3 2.3"/></svg>
{%- endcapture -%}

{%- capture icon_woman -%}
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 10.5c0-3.3 2-5.5 4.5-5.5s4.5 2.2 4.5 5.5c0 3.1-2 5.5-4.5 5.5s-4.5-2.4-4.5-5.5Z"/><path d="M7.6 9.5c1.6-.2 3.2-1.1 4.1-2.4 1 1.4 2.6 2.3 4.3 2.4"/><path d="M7.5 10.5c-1.2 1-2 2.8-2.3 4.8M16.5 10.5c1.2 1 2 2.8 2.3 4.8"/><path d="M10.2 11.4h.1M13.8 11.4h.1"/><path d="M10.7 13.7c.8.5 1.8.5 2.6 0"/></svg>
{%- endcapture -%}

{%- capture icon_cycle -%}
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 9.8A8 8 0 0 0 6.6 6.4"/><path d="M4.5 14.2a8 8 0 0 0 12.9 3.4"/><path d="M6.8 3.6 6.4 6.8l3.2.4"/><path d="M17.2 20.4l.4-3.2-3.2-.4"/></svg>
{%- endcapture -%}

<section id="BalanceBanner-{{ section.id }}" class="bb">
  <div class="bb__media">
    {%- if has_desktop -%}
      <img
        class="bb__img bb__img--desktop"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w,
                {{ section.settings.image | image_url: width: 1800 }} 1800w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        {% if section.settings.eager_load %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
        decoding="async"
      >
    {%- endif -%}

    {%- if section.settings.image_mobile != blank -%}
      <img
        class="bb__img bb__img--mobile"
        src="{{ section.settings.image_mobile | image_url: width: 1200 }}"
        srcset="{{ section.settings.image_mobile | image_url: width: 600 }} 600w,
                {{ section.settings.image_mobile | image_url: width: 900 }} 900w,
                {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w"
        sizes="100vw"
        alt="{{ section.settings.image_mobile.alt | default: section.settings.heading | strip_html | escape }}"
        width="{{ section.settings.image_mobile.width }}"
        height="{{ section.settings.image_mobile.height }}"
        {% if section.settings.eager_load %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
        decoding="async"
      >
    {%- endif -%}

    {%- unless has_desktop or section.settings.image_mobile != blank -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'bb__img' }}
    {%- endunless -%}

    <div class="bb__overlay">
      {%- if section.settings.heading != blank -%}
        <h2 class="bb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="bb__pills">
          {%- for block in section.blocks -%}
            {%- liquid
              assign icon = icon_lotus
              case block.settings.icon
                when 'uterus'
                  assign icon = icon_uterus
                when 'woman'
                  assign icon = icon_woman
                when 'cycle'
                  assign icon = icon_cycle
              endcase
              assign tag = 'div'
              if block.settings.link != blank
                assign tag = 'a'
              endif
            -%}
            <{{ tag }}
              class="bb__pill"
              {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
              style="background: {{ block.settings.color }};"
              {{ block.shopify_attributes }}
            >
              <span class="bb__pill-icon">{{ icon }}</span>
              <span>{{ block.settings.label }}</span>
            </{{ tag }}>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.edge_fade_width > 0 -%}
      <span class="bb__fade"></span>
    {%- endif -%}
    {%- if section.settings.fade_bottom -%}
      <span class="bb__fade--y"></span>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Balance banner",
  "tag": "section",
  "class": "section-balance-banner",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "Use a version without baked-in text so the heading and pills stay crisp and editable." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. A taller crop works better on phones." },
    { "type": "checkbox", "id": "eager_load", "label": "Load immediately (use above the fold)", "default": false },

    { "type": "header", "content": "Heading" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>The Perfect Balance<br>For Your Everyday Life</p>", "info": "Leave empty if the heading is already part of the image." },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "playfair_display_n7" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#B21351" },
    { "type": "range", "id": "heading_size", "min": 2, "max": 8, "step": 0.1, "label": "Heading size", "default": 5.2, "unit": "vw" },
    { "type": "range", "id": "heading_top", "min": 0, "max": 40, "step": 1, "label": "Heading position from top", "default": 4, "unit": "%" },

    { "type": "header", "content": "Benefit pills" },
    { "type": "range", "id": "pills_left", "min": 0, "max": 90, "step": 1, "label": "Pills from left", "default": 62, "unit": "%" },
    { "type": "range", "id": "pills_top", "min": 0, "max": 90, "step": 1, "label": "Pills from top", "default": 30, "unit": "%" },
    { "type": "range", "id": "pills_width", "min": 15, "max": 60, "step": 1, "label": "Pills width", "default": 27, "unit": "%" },
    { "type": "checkbox", "id": "stack_on_mobile", "label": "Move pills below the image on mobile", "default": true },

    { "type": "header", "content": "Edges" },
    { "type": "color", "id": "edge_fade_color", "label": "Edge fade color", "default": "#FFFFFF" },
    { "type": "range", "id": "edge_fade_width", "min": 0, "max": 30, "step": 1, "label": "Edge fade width", "default": 15, "unit": "%" },
    { "type": "checkbox", "id": "fade_bottom", "label": "Fade the bottom edge too", "default": false },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FBD7E1" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 80, "step": 4, "label": "Space above", "default": 0, "unit": "px" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 80, "step": 4, "label": "Space below", "default": 20, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Benefit pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "PMS" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lotus", "label": "Lotus" },
            { "value": "uterus", "label": "Uterus" },
            { "value": "woman", "label": "Woman" },
            { "value": "cycle", "label": "Cycle arrows" }
          ],
          "default": "lotus"
        },
        { "type": "color", "id": "color", "label": "Pill color", "default": "#F0679F" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Adds hover and focus states." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Balance banner",
      "blocks": [
        { "type": "pill", "settings": { "label": "PMS", "icon": "lotus", "color": "#F0679F" } },
        { "type": "pill", "settings": { "label": "PCOS", "icon": "uterus", "color": "#F58A1F" } },
        { "type": "pill", "settings": { "label": "Perimenopause", "icon": "woman", "color": "#A98BE6" } },
        { "type": "pill", "settings": { "label": "Cycle Support", "icon": "cycle", "color": "#16A79F" } }
      ]
    }
  ]
}
{% endschema %}

