  /* MOBILE SLIDER */

  @media (max-width:767px){

    .primary-focus-grid{
    display: flex;
    overflow-x: auto;
    gap: 20px;
    scroll-snap-type:x mandatory;
    scroll-behavior:smooth;
    -ms-overflow-style:none;
    scrollbar-width:none;
  }

  .primary-focus-grid::-webkit-scrollbar{
