  }
  }
{% endstyle %}

<section class="primary-focus-section page-width">
  <div class="primary-focus-container">
    <h2 class="primary-focus-title psheadmobile">
      {{ section.settings.heading }}
    </h2>

    <div class="newsletter-divider">
      <span></span>
      <img src="https://cdn.shopify.com/s/files/1/0245/2422/6606/files/logozynn.png?v=1772427108">
      <span></span>
    </div>

    <p class="primary-focus-subtitle">
      {{ section.settings.subheading }}
    </p>

    <div class="primary-focus-grid" id="focus-slider">
      {% for block in section.blocks %}
        <div class="primary-focus-card">
          <div class="primary-focus-image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag }}
            {% endif %}
          </div>

          <div class="primary-focus-content">
            <ul>
              {% assign lines = block.settings.points | newline_to_br | split: '<br />' %}
              {% for line in lines %}
                {% if line != blank %}
                  <li> {{ line }}</li>
                {% endif %}
              {% endfor %}
            </ul>
            {% if block.settings.button_label != blank %}
            <div class="card-btn mobile">
              <a class="pszyenbtn" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label }}
              </a>
            </div>
          {% endif %}
          </div>

          {% if block.settings.button_label != blank %}
            <div class="card-btn desktop">
              <a class="pszyenbtn" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label }}
              </a>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.innerWidth <= 767) {
      const slider = document.getElementById('focus-slider');
      const cards = slider.querySelectorAll('.primary-focus-card');

      let index = 0;

      setInterval(function () {
        index++;

        if (index >= cards.length) {
          index = 0;

          slider.scrollTo({
            left: 0,
            behavior: 'smooth',
          });
        } else {
          slider.scrollTo({
            left: cards[index].offsetLeft,
            behavior: 'smooth',
          });
        }
      }, 3000);
    }
  });
</script>

