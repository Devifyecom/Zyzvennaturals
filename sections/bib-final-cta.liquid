{{ 'bib.css' | asset_url | stylesheet_tag }}

<section class="bib bib-final" id="bib-final">
  <div class="bib__inner">
    <h2 class="bib-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}
      <p class="bib-final__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}

    <a
      href="{{ section.settings.cta_anchor | default: '#bib-hero' }}"
      class="bib-btn"
      data-bib-scroll
      data-bib-cta="final"
    >
      {{ section.settings.cta_label }}
    </a>
  </div>
  <div class="bib-page-end" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "BIB — Final CTA",
  "tag": "section",
  "class": "bib-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "Ready to Build Something of Your Own?" },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Start with products customers already know, supported by training and a brand built for long-term wellness."
    },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Buy Business in a Box — $999" },
    { "type": "text", "id": "cta_anchor", "label": "CTA anchor", "default": "#bib-hero" }
  ],
  "presets": [{ "name": "BIB — Final CTA" }]
}
{% endschema %}
