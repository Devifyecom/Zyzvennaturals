{% comment %}
  Section: How do you want to feel? (feel-grid)
  Shop-by-feeling grid. Each card = one block.
  Font: Golos Text
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  #feelgrid-{{ section.id }}{
    --pink: {{ section.settings.accent_color }};
    --ink: {{ section.settings.heading_color }};
    --muted: {{ section.settings.text_color }};
    --cat:#9a9a9a;
    --card-border:#efefef;
    --fg-font:"Golos Text",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family:var(--fg-font);
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
  }
  #feelgrid-{{ section.id }} *{box-sizing:border-box;}
  #feelgrid-{{ section.id }} .fg-eyebrow,
  #feelgrid-{{ section.id }} .fg-head h2,
  #feelgrid-{{ section.id }} .fg-head p,
  #feelgrid-{{ section.id }} .fword,
  #feelgrid-{{ section.id }} .fcat,
  #feelgrid-{{ section.id }} .fname{
    font-family:var(--fg-font) !important;
  }

  #feelgrid-{{ section.id }} .fg-wrap{
    max-width:1240px;
    margin:0 auto;
    padding:0 24px;
  }

  /* ---------- Header ---------- */
  #feelgrid-{{ section.id }} .fg-head{
    text-align:center;
    margin-bottom:46px;
  }
  #feelgrid-{{ section.id }} .fg-eyebrow{
    font-size:13px;
    font-weight:700;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:var(--pink);
    margin-bottom:16px;
  }
  #feelgrid-{{ section.id }} .fg-head h2{
    margin:0;
    font-family:var(--fg-font);
    font-size:clamp(30px,5.4vw,53px);
    line-height:1.1;
    font-weight:700;
    letter-spacing:-.02em;
    color:var(--ink);
  }
  #feelgrid-{{ section.id }} .fg-head h2 .pink{color:var(--pink);}
  #feelgrid-{{ section.id }} .fg-head p{
    max-width:560px;
    margin:20px auto 0;
    font-size:18px;
    line-height:1.5;
    font-weight:400;
    color:var(--muted);
  }

  /* ---------- Grid ---------- */
  #feelgrid-{{ section.id }} .fg-grid{
    display:grid;
    grid-template-columns:repeat({{ section.settings.columns }},1fr);
    gap:22px;
  }

  /* ---------- Card ---------- */
  #feelgrid-{{ section.id }} .feel{
    display:flex;
    flex-direction:column;
    text-decoration:none;
    color:inherit;
    background:#fff;
    border:1px solid var(--card-border);
    border-radius:14px;
    overflow:hidden;
    box-shadow:0 1px 10px rgba(17,17,17,.04);
    transition:transform .28s ease, box-shadow .28s ease, border-color .28s ease;
  }
  #feelgrid-{{ section.id }} .feel:hover{
    transform:translateY(-4px);
    border-color:#f6d4e5;
    box-shadow:0 14px 34px rgba(17,17,17,.12);
  }
  #feelgrid-{{ section.id }} .feel:focus-visible{
    outline:2px solid var(--pink);
    outline-offset:3px;
  }

  /* ---------- Image tile ---------- */
  #feelgrid-{{ section.id }} .fimg{
    position:relative;
    aspect-ratio:1 / 1.28;
    background:var(--fc,#eee);
    overflow:hidden;
  }
  #feelgrid-{{ section.id }} .fwoman{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:opacity .3s ease;
    z-index:1;
  }
  #feelgrid-{{ section.id }} .fimg::after{
    content:"";
    position:absolute;
    left:0;right:0;bottom:0;
    height:52%;
    background:linear-gradient(to top,rgba(0,0,0,.34),rgba(0,0,0,0));
    z-index:2;
    pointer-events:none;
    transition:opacity .3s ease;
  }
  #feelgrid-{{ section.id }} .fword{
    position:absolute;
    left:18px;
    bottom:15px;
    z-index:3;
    color:#fff;
    font-size:27px;
    font-weight:700;
    letter-spacing:-.01em;
    line-height:1;
    text-shadow:0 1px 10px rgba(0,0,0,.28);
    transition:opacity .25s ease;
  }
  #feelgrid-{{ section.id }} .fp{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:contain;
    background:#fff;
    padding:20px;
    opacity:0;
    z-index:4;
    transition:opacity .3s ease;
  }
  #feelgrid-{{ section.id }} .feel:hover .fwoman{opacity:0;}
  #feelgrid-{{ section.id }} .feel:hover .fword{opacity:0;}
  #feelgrid-{{ section.id }} .feel:hover .fimg::after{opacity:0;}
  #feelgrid-{{ section.id }} .feel:hover .fp{opacity:1;}

  /* ---------- Caption ---------- */
  #feelgrid-{{ section.id }} .cap{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:4px;
    padding:14px 10px 17px;
    background:#fff;
    text-align:center;
  }
  #feelgrid-{{ section.id }} .fcat{
    font-size:11px;
    font-weight:600;
    letter-spacing:.15em;
    text-transform:uppercase;
    color:var(--cat);
  }
  #feelgrid-{{ section.id }} .fname{
    font-size:15px;
    font-weight:700;
    color:var(--ink);
  }

  /* ---------- Responsive ---------- */
  @media (max-width:1080px){
    #feelgrid-{{ section.id }} .fg-grid{grid-template-columns:repeat(3,1fr);}
  }
  @media (max-width:680px){
    #feelgrid-{{ section.id }}{padding:52px 0 60px;}
    #feelgrid-{{ section.id }} .fg-grid{grid-template-columns:repeat(2,1fr);gap:16px;}
    #feelgrid-{{ section.id }} .fword{font-size:23px;left:14px;bottom:13px;}
  }
  @media (prefers-reduced-motion:reduce){
    #feelgrid-{{ section.id }} .feel,
    #feelgrid-{{ section.id }} .fwoman,
    #feelgrid-{{ section.id }} .fword,
    #feelgrid-{{ section.id }} .fp,
    #feelgrid-{{ section.id }} .fimg::after{transition:none;}
    #feelgrid-{{ section.id }} .feel:hover{transform:none;}
  }
</style>

<section id="feelgrid-{{ section.id }}">
  <div class="fg-wrap">
    <div class="fg-head">
      {% if section.settings.eyebrow != blank %}
        <div class="fg-eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}
      <h2>
        {%- if section.settings.heading_pink != blank -%}
          <span class="pink">{{ section.settings.heading_pink }}</span>{{ ' ' }}
        {%- endif -%}
        {{- section.settings.heading -}}
      </h2>
      {% if section.settings.subtitle != blank %}
        <p>{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="fg-grid">
      {% for block in section.blocks %}
        <a class="feel"
           style="--fc:{{ block.settings.accent }}"
           href="{{ block.settings.url | default: '#' }}"
           {{ block.shopify_attributes }}>
          <div class="fimg">
            {% if block.settings.lifestyle_image != blank %}
              <img class="fwoman"
                   src="{{ block.settings.lifestyle_image | image_url: width: 600 }}"
                   srcset="{{ block.settings.lifestyle_image | image_url: width: 400 }} 400w,
                           {{ block.settings.lifestyle_image | image_url: width: 600 }} 600w,
                           {{ block.settings.lifestyle_image | image_url: width: 800 }} 800w"
                   sizes="(max-width:680px) 45vw, 240px"
                   alt="{{ block.settings.word | escape }} - {{ block.settings.name | escape }}"
                   width="600" height="768" loading="lazy">
            {% endif %}
            {% if block.settings.word != blank %}
              <span class="fword">{{ block.settings.word }}</span>
            {% endif %}
            {% if block.settings.product_image != blank %}
              <img class="fp"
                   src="{{ block.settings.product_image | image_url: width: 600 }}"
                   alt="{{ block.settings.name | escape }} product"
                   width="600" height="768" loading="lazy">
            {% endif %}
          </div>
          <div class="cap">
            {% if block.settings.category != blank %}
              <span class="fcat">{{ block.settings.category }}</span>
            {% endif %}
            <span class="fname">{{ block.settings.name }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feel Grid",
  "tag": "section",
  "class": "section-feel-grid",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Start here" },
    { "type": "text", "id": "heading_pink", "label": "Heading (pink part)", "default": "Hey Girl." },
    { "type": "text", "id": "heading", "label": "Heading (rest)", "default": "How do you want to feel?" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Shop by what your body is asking for. A tea and a supplement for every part of your day." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "min": 3, "max": 6, "step": 1, "label": "Columns (desktop)", "default": 5 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 76 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 84 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent (pink)", "default": "#ec4c8f" },
    { "type": "color", "id": "heading_color", "label": "Heading text", "default": "#2b2b2b" },
    { "type": "color", "id": "text_color", "label": "Subtitle text", "default": "#707070" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "word", "label": "Overlay word", "default": "Debloated" },
        { "type": "text", "id": "category", "label": "Category label", "default": "Tea" },
        { "type": "text", "id": "name", "label": "Product name", "default": "Cleanse Tea" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "color", "id": "accent", "label": "Tile accent color", "default": "#e45891" },
        { "type": "image_picker", "id": "lifestyle_image", "label": "Lifestyle image" },
        { "type": "image_picker", "id": "product_image", "label": "Product image (hover)" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Feel Grid",
      "blocks": [
        { "type": "card", "settings": { "word": "Debloated", "category": "Tea", "name": "Cleanse Tea", "accent": "#e45891" } },
        { "type": "card", "settings": { "word": "Rested", "category": "Tea", "name": "Sleep Tea", "accent": "#9b6bf2" } },
        { "type": "card", "settings": { "word": "Energized", "category": "Tea", "name": "Energize Tea", "accent": "#d99400" } },
        { "type": "card", "settings": { "word": "Immune", "category": "Tea", "name": "Feel Better Tea", "accent": "#2f9bd6" } },
        { "type": "card", "settings": { "word": "Balanced", "category": "Tea", "name": "Hormone Balance Tea", "accent": "#ff5fa2" } },
        { "type": "card", "settings": { "word": "Lighter", "category": "Supplement", "name": "Apple Cider Vinegar", "accent": "#f0512e" } },
        { "type": "card", "settings": { "word": "Protected", "category": "Supplement", "name": "D-Mannose", "accent": "#f7770f" } },
        { "type": "card", "settings": { "word": "Calm", "category": "Supplement", "name": "Ashwagandha", "accent": "#c77d4a" } },
        { "type": "card", "settings": { "word": "Glowing", "category": "Supplement", "name": "Nice Hair", "accent": "#2f9bd6" } },
        { "type": "card", "settings": { "word": "In Control", "category": "Supplement", "name": "Hormone Balance", "accent": "#e35890" } }
      ]
    }
  ]
}
{% endschema %}

