<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400&family=Mulish:wght@400;700&display=swap">
{%- liquid
  assign s = section.settings
  assign wa_digits = s.whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign phone_digits = s.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign links = section.blocks | where: 'type', 'link'
  assign flags = section.blocks | where: 'type', 'flag'
  assign sid = section.id
-%}

<style>
  #znb-contact-{{ sid }} {
    --c-bg: #f0eee8;
    --c-ink: #1f3a30;
    --c-body: #4a4a42;
    --c-link: #3b3b35;
    --c-gold: #8e6b2e;
    --c-serif: var(--znb-font-serif, var(--font-heading-family, "Fraunces", "Georgia", serif));
    --c-sans: var(--znb-font-sans, var(--font-body-family, "Mulish", "Helvetica Neue", Arial, sans-serif));

    background: var(--c-bg);
    color: var(--c-body);
    font-family: var(--c-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  #znb-contact-{{ sid }} .znb-c__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto;
    column-gap: 48px;
    row-gap: 56px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 72px 56px 78px;
  }

  #znb-contact-{{ sid }} .znb-c__h2 {
    margin: 0 0 28px;
    font-family: var(--c-serif);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.005em;
    color: var(--c-ink);
  }

  #znb-contact-{{ sid }} ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ---------- Contact list ---------- */
  #znb-contact-{{ sid }} .znb-c__list {
    display: flex;
    flex-direction: column;
    gap: 29px;
  }
  #znb-contact-{{ sid }} .znb-c__list a {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.03em;
    color: var(--c-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  #znb-contact-{{ sid }} .znb-c__list svg {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    color: var(--c-gold);
  }
  #znb-contact-{{ sid }} .znb-c__list a:hover { color: var(--c-gold); }

  /* ---------- Flags ---------- */
  #znb-contact-{{ sid }} .znb-c__flags {
    display: flex;
    flex-wrap: wrap;
    max-width: 375px;
    column-gap: 27px;
    row-gap: 19px;
  }
  #znb-contact-{{ sid }} .znb-c__flags li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.045em;
    color: var(--c-body);
  }
  #znb-contact-{{ sid }} .znb-c__flag {
    flex: 0 0 44px;
    display: block;
    width: 44px;
    height: 31px;
    overflow: hidden;
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(31, 58, 48, 0.12);
  }
  #znb-contact-{{ sid }} .znb-c__flag svg,
  #znb-contact-{{ sid }} .znb-c__flag img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Links ---------- */
  #znb-contact-{{ sid }} .znb-c__links {
    display: flex;
    flex-direction: column;
    gap: 19px;
  }
  #znb-contact-{{ sid }} .znb-c__links a {
    font-size: 18.5px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.045em;
    color: var(--c-link);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    text-decoration-color: currentColor;
    transition: color 0.2s ease;
  }
  #znb-contact-{{ sid }} .znb-c__links a:hover { color: var(--c-gold); }

  #znb-contact-{{ sid }} a:focus-visible {
    outline: 2px solid var(--c-gold);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    #znb-contact-{{ sid }} .znb-c__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 64px 40px 68px;
    }
    #znb-contact-{{ sid }} .znb-c__col--contact { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    #znb-contact-{{ sid }} .znb-c__grid {
      grid-template-columns: 1fr;
      row-gap: 44px;
      padding: 48px 20px 52px;
    }
    #znb-contact-{{ sid }} .znb-c__h2 { margin-bottom: 22px; font-size: 30px; }
    #znb-contact-{{ sid }} .znb-c__list { gap: 22px; }
    #znb-contact-{{ sid }} .znb-c__list a { gap: 14px; font-size: 18px; word-break: break-word; }
    #znb-contact-{{ sid }} .znb-c__list svg { flex-basis: 20px; width: 20px; height: 20px; }
    #znb-contact-{{ sid }} .znb-c__flags { max-width: none; column-gap: 22px; row-gap: 16px; }
    #znb-contact-{{ sid }} .znb-c__flags li { font-size: 16px; }
    #znb-contact-{{ sid }} .znb-c__flag { flex-basis: 40px; width: 40px; height: 28px; }
    #znb-contact-{{ sid }} .znb-c__links { gap: 16px; }
    #znb-contact-{{ sid }} .znb-c__links a { font-size: 17px; }
  }
</style>

<section class="znb znb--parch znb-contact" id="znb-contact-{{ sid }}">
  <div class="znb-c__grid">
    <div class="znb-c__col znb-c__col--contact">
      <h2 class="znb-c__h2">{{ s.heading }}</h2>
      <ul class="znb-c__list" role="list">
        {%- if wa_digits != blank -%}
          <li>
            <a href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.6 20.4l1.2-4.1A8.6 8.6 0 1 1 8 19.3l-4.4 1.1z"/><path d="M9.1 8.2c.2-.4.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.7l-.5.6c-.1.1-.1.3 0 .5a6 6 0 0 0 2.8 2.6c.2.1.4 0 .5-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.7c.3.1.4.3.4.5v.5c0 .4-.2.7-.5.9-.6.4-1.4.6-2.2.4a8.3 8.3 0 0 1-5.6-5.5c-.2-.9 0-1.6.4-2.2z"/></svg>
              <span>WhatsApp {{ s.whatsapp }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if phone_digits != blank -%}
          <li>
            <a href="tel:{{ phone_digits }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.3 3.5l1.9 3.9c.2.4.1.9-.2 1.2l-1.7 1.6a11.4 11.4 0 0 0 5.5 5.5l1.6-1.7c.3-.3.8-.4 1.2-.2l3.9 1.9c.4.2.6.7.5 1.1l-.5 2.1c-.2.8-.9 1.3-1.7 1.3A15.4 15.4 0 0 1 3.8 5.3c0-.8.5-1.5 1.3-1.7l2.1-.5c.4-.1.9.1 1.1.4z"/></svg>
              <span>{{ s.phone_label }} {{ s.phone }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if s.email != blank -%}
          <li>
            <a href="mailto:{{ s.email }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.75" y="5" width="18.5" height="14" rx="1.5"/><path d="M3.3 6l8.7 7 8.7-7"/></svg>
              <span>{{ s.email }}</span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    </div>

    {%- if flags.size > 0 -%}
      <div class="znb-c__col">
        <h2 class="znb-c__h2">{{ s.markets_heading }}</h2>
        <ul class="znb-c__flags" role="list">
          {%- for block in flags -%}
            {%- liquid
              assign code = block.settings.flag | default: 'auto'
              if code == 'auto'
                assign lbl = block.settings.label | downcase
                case lbl
                  when 'united states', 'usa', 'us', 'united states of america'
                    assign code = 'us'
                  when 'united kingdom', 'uk', 'great britain', 'england'
                    assign code = 'gb'
                  when 'canada'
                    assign code = 'ca'
                  when 'sweden'
                    assign code = 'se'
                  when 'jamaica'
                    assign code = 'jm'
                  else
                    assign code = 'none'
                endcase
              endif
              assign uid = sid | append: '-' | append: block.id
            -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <span class="znb-c__flag">{{ block.settings.image | image_url: width: 132 | image_tag: loading: 'lazy', alt: '' }}</span>
              {%- elsif code != 'none' -%}
                <span class="znb-c__flag" aria-hidden="true">
                  {%- case code -%}
                    {%- when 'us' -%}
                      <svg viewBox="0 0 7410 3900" preserveAspectRatio="xMidYMid slice"><rect width="7410" height="3900" fill="#b0283a"/><path d="M0 450h7410M0 1050h7410M0 1650h7410M0 2250h7410M0 2850h7410M0 3450h7410" stroke="#fff" stroke-width="300"/><rect width="2964" height="2100" fill="#2a2d5c"/></svg>
                    {%- when 'gb' -%}
                      <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice"><clipPath id="gbs-{{ uid }}"><path d="M0 0v30h60V0z"/></clipPath><clipPath id="gbt-{{ uid }}"><path d="M30 15h30v15zv15H0zH0V0zV0h30z"/></clipPath><g clip-path="url(#gbs-{{ uid }})"><path d="M0 0v30h60V0z" fill="#1f2a5e"/><path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6"/><path d="M0 0l60 30m0-30L0 30" clip-path="url(#gbt-{{ uid }})" stroke="#c3263a" stroke-width="4"/><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#c3263a" stroke-width="6"/></g></svg>
                    {%- when 'ca' -%}
                      <svg viewBox="0 0 9600 4800" preserveAspectRatio="xMidYMid slice"><rect width="9600" height="4800" fill="#d0312d"/><rect x="2400" width="4800" height="4800" fill="#fff"/><path fill="#d0312d" d="m4890 4430-45-863a95 95 0 0 1 111-98l859 151-116-320a65 65 0 0 1 20-73l941-762-212-99a65 65 0 0 1-34-79l186-572-542 115a65 65 0 0 1-73-38l-105-247-423 454a65 65 0 0 1-111-57l204-1052-327 189a65 65 0 0 1-91-27l-332-652-332 652a65 65 0 0 1-91 27l-327-189 204 1052a65 65 0 0 1-111 57l-423-454-105 247a65 65 0 0 1-73 38l-542-115 186 572a65 65 0 0 1-34 79l-212 99 941 762a65 65 0 0 1 20 73l-116 320 859-151a95 95 0 0 1 111 98l-45 863z"/></svg>
                    {%- when 'se' -%}
                      <svg viewBox="0 0 16 10" preserveAspectRatio="xMidYMid slice"><rect width="16" height="10" fill="#2a4a85"/><path d="M5 0v10M0 5h16" stroke="#ecc04a" stroke-width="2"/></svg>
                    {%- when 'jm' -%}
                      <svg viewBox="0 0 12 6" preserveAspectRatio="xMidYMid slice"><rect width="12" height="6" fill="#3a7050"/><path d="M0 0l5 3-5 3zM12 0L7 3l5 3z" fill="#141414"/><path d="M0 0l12 6M12 0L0 6" stroke="#e9b949" stroke-width="1"/></svg>
                  {%- endcase -%}
                </span>
              {%- endif -%}
              <span>{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if links.size > 0 -%}
      <div class="znb-c__col">
        <h2 class="znb-c__h2">{{ s.links_heading }}</h2>
        <ul class="znb-c__links" role="list">
          {%- for block in links -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BIAB Contact",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Contact heading", "default": "Talk to Our Team" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp", "default": "+44 7460 032301" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Jamaica" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "876-288-0806" },
    { "type": "text", "id": "email", "label": "Email", "default": "sales@zyzvennaturals.com" },
    { "type": "text", "id": "markets_heading", "label": "Markets heading", "default": "Where We Operate" },
    { "type": "text", "id": "links_heading", "label": "Links heading", "default": "Partner Information" }
  ],
  "blocks": [
    {
      "type": "flag",
      "name": "Market flag",
      "settings": [
        { "type": "text", "id": "label", "label": "Country", "default": "United States" },
        {
          "type": "select",
          "id": "flag",
          "label": "Built-in flag",
          "info": "Auto picks the flag from the country name. An uploaded image below overrides this.",
          "default": "auto",
          "options": [
            { "value": "auto", "label": "Auto (from country name)" },
            { "value": "us", "label": "United States" },
            { "value": "gb", "label": "United Kingdom" },
            { "value": "ca", "label": "Canada" },
            { "value": "se", "label": "Sweden" },
            { "value": "jm", "label": "Jamaica" },
            { "value": "none", "label": "No flag" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Custom flag image" }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Reseller Terms" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BIAB Contact",
      "blocks": [
        { "type": "flag", "settings": { "label": "United States" } },
        { "type": "flag", "settings": { "label": "United Kingdom" } },
        { "type": "flag", "settings": { "label": "Canada" } },
        { "type": "flag", "settings": { "label": "Sweden" } },
        { "type": "flag", "settings": { "label": "Jamaica" } },
        { "type": "link", "settings": { "label": "Partner With Us" } },
        { "type": "link", "settings": { "label": "Reseller Terms" } },
        { "type": "link", "settings": { "label": "Shipping Policy" } },
        { "type": "link", "settings": { "label": "Returns" } },
        { "type": "link", "settings": { "label": "Privacy" } }
      ]
    }
  ]
}
{% endschema %}

