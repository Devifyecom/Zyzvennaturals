/* CARD */
.card {
  display: flex !important;
  flex-direction: row !important;
  justify-content: space-between;
  align-items: center;
  padding: 18px !important;
  border-radius: 14px;
  border: 1px solid #e5e5e5;
  background: #fff !important;
  transition: 0.25s;
  cursor: pointer;
}
#step-2 .card{
  justify-content: center;
}

.card:hover {
  transform: translateY(-2px);
  border-color: #ccc;
}

/* LEFT */
.card-left {
  display: flex;
  gap: 12px;
  align-items: center;
  text-align: start;
}

.card-icon {
  width: 42px;
  height: 42px;
  background: #f3f3f3;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* TEXT */
.card-title {
  font-weight: 500;
}

.card-desc {
  font-size: 13px;
  color: #777;
}

/* RADIO */
.card-radio {
  width: 20px;
  height: 20px;
  border: 2px solid #ccc;
  border-radius: 50%;
}

/* ACTIVE */
.card.active {
  border-color: #2e7d32 !important;
  background: #f7faf7 !important;
}

.card.active .card-radio {
  border-color: #2e7d32;
  position: relative;
}

.card.active .card-radio::after {
  content: "";
  width: 10px;
  height: 10px;
  background: #2e7d32;
  border-radius: 50%;
  position: absolute;
  top: 3px;
  left: 3px;
}

/* =========================
   MOBILE RESPONSIVE FIX
========================= */

@media (max-width: 768px) {

  .assessment-wrapper {
    padding: 0 16px;
  }

  /* HERO */
  .hero-title {
    font-size: 30px;
    line-height: 1.3;
  }

  .hero-subtext {
    font-size: 14px;
  }

  .hero-tags span {
    font-size: 12px;
    padding: 6px 10px;
  }

  .hero-btn {
    width: 100%;
    padding: 14px;
  }

  /* STEP */
  .step-title {
    font-size: 24px;
  }

  .step-subtext {
    font-size: 13px;
  }

  /* GRID → SINGLE COLUMN */
  .card-grid {
    grid-template-columns: 1fr !important;
    gap: 12px;
  }

  /* CARD */
  .card {
    padding: 14px !important;
  }

  .card-icon {
    width: 36px;
    height: 36px;
    font-size: 16px;
  }

  .card-title {
    font-size: 14px;
  }

  .card-desc {
    font-size: 12px;
  }

  /* STEP HEADER */
  .step-header {
    flex-direction: column;
    gap: 5px;
  }

  .step-count {
    font-size: 12px;
  }

  .step-label {
    font-size: 11px;
  }

  /* RESULT BOX */
  .result-box {
    padding: 15px;
  }

  /* BUTTONS */
  .primary-btn {
    width: 100%;
  }

  #cta-btn {
    width: 100%;
  }

}


/* =========================
   SMALL DEVICES (≤480px)
========================= */

@media (max-width: 480px) {

  .hero-title {
    font-size: 26px;
  }

  .step-title {
    font-size: 22px;
  }

  .hero-proof {
    font-size: 12px;
    line-height: 1.5;
  }

  .hero-badges span {
    font-size: 11px;
  }

}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let selections = [];
    let duration = null;
    let selectedProducts = [];

    function setProgress(step) {
      const progress = document.getElementById('progressFill');
      let width = 0;
      if (step === 2) width = 33;
      if (step === 3) width = 66;
      if (step === 4) width = 100;
      progress.style.width = width + '%';
    }

    function showToast(message, type = 'error') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.className = 'toast show ' + type;

      setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }

    const mapping = {
      hormone: { url: '/pages/protocols-30-day-hormone-balance', label: 'Hormone & Menopause Support' },
      metabolic: { url: '/pages/protocols-30-day-metabolic-balance', label: 'Metabolic & Blood Sugar Balance' },
      digestive: { url: '/pages/protocols-30-day-digestive-reset', label: 'Digestive & Detox Reset' },
      inflammation: { url: '/pages/protocols-30-day-inflammation-support', label: 'Inflammation & Joint Support' },
      mens: { url: '/pages/protocols-30-day-mens-vitality', label: 'Men’s Vitality & Prostate' },
      skin: { url: '/pages/protocols-30-day-skin-support', label: 'Skin & Ageing Support' },
    };

    // START
    document.getElementById('start-btn').onclick = () => {
      document.getElementById('hero').classList.add('hidden');
      document.getElementById('step-1').classList.remove('hidden');
      setProgress(2);
    };

    // STEP 1
    document.querySelectorAll('#step-1 .card').forEach((card) => {
      card.onclick = () => {
        card.classList.toggle('active');

        selections = Array.from(document.querySelectorAll('#step-1 .card.active')).map((c) => c.dataset.value);

        if (selections.length > 2) {
          card.classList.remove('active');
          selections.pop();
          showToast('You can select up to 2 options only.', 'error');
        }
      };
    });

    document.getElementById('step1-btn').onclick = () => {
      if (selections.length === 0) {
        showToast('Please select at least one option.', 'error');
        return;
      }

      document.getElementById('step-1').classList.add('hidden');
      document.getElementById('step-2').classList.remove('hidden');
      setProgress(3);
    };

    // STEP 2
    document.querySelectorAll('#step-2 .card').forEach((card) => {
      card.onclick = () => {
        document.querySelectorAll('#step-2 .card').forEach((c) => c.classList.remove('active'));
        card.classList.add('active');
        duration = card.dataset.value;
      };
    });

    // FETCH PRODUCTS
    async function fetchProtocolProducts(url) {
      try {
        const res = await fetch(url);
        const html = await res.text();

        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const el = doc.querySelector('#protocol-data');

        if (el) {
          const data = JSON.parse(el.textContent.trim());
          return data.products || [];
        }

        return [];
      } catch (e) {
        console.error('Fetch error:', e);
        return [];
      }
    }

    // RESULT
    document.getElementById('result-btn').onclick = async () => {
      if (!duration) {
        showToast('Please select an option.', 'error');
        return;
      }

      const primary = selections[0];
      const secondary = selections[1];

      showToast('Building your plan...', 'success');

      const primaryProducts = await fetchProtocolProducts(mapping[primary].url);
      const secondaryProducts = secondary ? await fetchProtocolProducts(mapping[secondary].url) : [];

      selectedProducts = [...primaryProducts, ...secondaryProducts];

      // REMOVE DUPLICATES
      selectedProducts = selectedProducts.filter((v, i, a) => a.findIndex((t) => t.id === v.id) === i);

      function renderProducts(products) {
        return products
          .map(
            (p) => `
        <div style="text-align:center; width:150px;">
          <img src="${p.image}" style="width:100%; height:auto;">
        </div>
      `
          )
          .join('<div class="combo-plus">+</div>');
      }

      document.getElementById('primary-result').innerHTML = `
      <strong>Primary Recommendation</strong><br>
      <a href="${mapping[primary].url}" class="link link--text">${mapping[primary].label}</a>
      <div style="display:flex; gap:10px; margin-top:10px; flex-wrap:wrap; justify-content:center;">
        ${renderProducts(primaryProducts)}
      </div>
    `;

      if (secondary) {
        document.getElementById('secondary-result').innerHTML = `
        <strong>Secondary Recommendation</strong><br>
        <a href="${mapping[secondary].url}" class="link link--text">${mapping[secondary].label}</a>
        <div style="display:flex; gap:10px; margin-top:10px; flex-wrap:wrap; justify-content:center;">
          ${renderProducts(secondaryProducts)}
        </div>
      `;
      }

      // ADD TO CART
      document.getElementById('cta-btn').onclick = async (e) => {
        e.preventDefault();

        const btn = document.getElementById('cta-btn');

        if (!selectedProducts.length) {
          showToast('No products found', 'error');
          return;
        }

        // LOADER ON
        btn.classList.add('loading');
        btn.dataset.originalText = btn.innerHTML;
        btn.style.pointerEvents = 'none';

        const items = selectedProducts.map((p) => ({
          id: p.id,
          quantity: 1,
        }));

        try {
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items }),
          });

          const res = await fetch('/?sections=cart-drawer,cart-icon-bubble');
          const data = await res.json();

          const parser = new DOMParser();
          const drawer = document.querySelector('cart-drawer');

          if (drawer && data['cart-drawer']) {
            const html = parser.parseFromString(data['cart-drawer'], 'text/html');
            const newDrawer = html.querySelector('cart-drawer');
            if (newDrawer) drawer.innerHTML = newDrawer.innerHTML;
          }

          const bubble = document.querySelector('#cart-icon-bubble');
          if (bubble && data['cart-icon-bubble']) {
            const html = parser.parseFromString(data['cart-icon-bubble'], 'text/html');
            const newBubble = html.querySelector('#cart-icon-bubble');
            if (newBubble) bubble.innerHTML = newBubble.innerHTML;
          }

          if (drawer) {
            drawer.classList.remove('is-empty');

            if (typeof drawer.open === 'function') {
              drawer.open();
            } else {
              drawer.classList.add('active');
              document.body.classList.add('overflow-hidden');
            }
          }

          showToast('All products added to cart', 'success');
        } catch (e) {
          console.error(e);
          showToast('Something went wrong', 'error');
        } finally {
          // LOADER OFF
          btn.classList.remove('loading');
          btn.innerHTML = btn.dataset.originalText;
          btn.style.pointerEvents = 'auto';
        }
      };

      document.getElementById('step-2').classList.add('hidden');
      document.getElementById('result').classList.remove('hidden');

      setProgress(4);
    };
  });
</script>

