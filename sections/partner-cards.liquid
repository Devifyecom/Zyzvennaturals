{{ 'biab.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  capture box_price
    render 'biab-money', box: true
  endcapture
-%}

<style>
  #partner-cards-{{ sid }} .pc__card { display: flex; flex-direction: column; height: 100%; position: relative; }
  #partner-cards-{{ sid }} .pc__card--featured { border-top: 4px solid var(--biab-gold); }
  #partner-cards-{{ sid }} .pc__icon {
    width: 52px; height: 52px; border-radius: 14px; margin-bottom: var(--biab-3);
    display: grid; place-items: center;
    background: var(--biab-green-100); color: var(--biab-green-800);
  }
  #partner-cards-{{ sid }} .pc__card--featured .pc__icon { background: var(--biab-gold-100); color: var(--biab-gold-600); }
  #partner-cards-{{ sid }} .pc__icon svg { width: 26px; height: 26px; }
  #partner-cards-{{ sid }} .pc__badge {
    align-self: flex-start; margin: 0 0 var(--biab-2);
    padding: 5px 12px; border-radius: 999px;
    background: var(--biab-green-800); color: #fff;
    font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
  }
  #partner-cards-{{ sid }} .pc__text { flex: 1 1 auto; }
  #partner-cards-{{ sid }} .pc__text p { font-size: 16px; line-height: 1.7; color: var(--biab-ink-600); margin: 0 0 var(--biab-2); }
  #partner-cards-{{ sid }} .pc__text p:last-child { margin-bottom: 0; }
  #partner-cards-{{ sid }} .pc__link {
    margin-top: var(--biab-3); align-self: flex-start;
    font-weight: 600; font-size: 15px; color: var(--biab-green-800);
    text-decoration: underline; text-decoration-color: var(--biab-gold); text-underline-offset: 5px; text-decoration-thickness: 2px;
  }
  #partner-cards-{{ sid }} .pc__link:hover { color: var(--biab-gold-600); }
  #partner-cards-{{ sid }} .pc__cta { margin-top: var(--biab-3); align-self: flex-start; padding: 13px 24px; font-size: 15px; }
  #partner-cards-{{ sid }} .pc__plain .pc__card { box-shadow: none; }
  #partner-cards-{{ sid }} .biab-note { margin-top: var(--biab-5); text-align: center; }
  #partner-cards-{{ sid }} .biab-note p { margin: 0; }
</style>

<div class="biab {% if s.background == 'cream' %}biab--cream{% else %}biab--white{% endif %}" id="partner-cards-{{ sid }}">
  <section class="biab-section" id="{{ s.anchor | default: sid | handleize }}" aria-labelledby="PartnerCardsTitle-{{ sid }}">
    <div class="biab-inner">
      <div class="biab-head">
        {%- if s.eyebrow != blank -%}<p class="biab-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="biab-h2" id="PartnerCardsTitle-{{ sid }}">{{ s.heading }}</h2>
        <hr class="biab-rule">
        {%- if s.subheading != blank -%}<p class="biab-lede">{{ s.subheading }}</p>{%- endif -%}
      </div>

      <div class="biab-grid biab-grid--{{ s.columns }}{% if s.plain_cards %} pc__plain{% endif %}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign link_url = b.link_url
            if b.enquiry_type != blank and link_url == blank
              assign link_url = '#partner-enquiry'
            endif
          -%}
          <div class="biab-card pc__card{% if b.featured %} pc__card--featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if b.badge != blank -%}<p class="pc__badge">{{ b.badge }}</p>{%- endif -%}
            {%- if b.icon != 'none' -%}
              <div class="pc__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  {%- case b.icon -%}
                    {%- when 'box' -%}<path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>
                    {%- when 'store' -%}<path d="M4 10v10h16V10"/><path d="M2 10l2-6h16l2 6"/><path d="M2 10a2.5 2.5 0 005 0 2.5 2.5 0 005 0 2.5 2.5 0 005 0 2.5 2.5 0 005 0"/><path d="M10 20v-5h4v5"/>
                    {%- when 'leaf' -%}<path d="M5 19c0-8 5-14 15-15-1 10-7 15-15 15z"/><path d="M5 19l7-7"/>
                    {%- when 'star' -%}<path d="M12 3l2.6 5.6 6 .6-4.5 4 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.5-4 6-.6z"/>
                    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/>
                    {%- when 'book' -%}<path d="M4 5a2 2 0 012-2h13v16H6a2 2 0 00-2 2V5z"/><path d="M4 19a2 2 0 012-2h13"/>
                    {%- when 'globe' -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 010 18M12 3a14 14 0 000 18"/>
                    {%- when 'people' -%}<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0113 0"/><path d="M16 4.5a3.5 3.5 0 010 7"/><path d="M18 14a6.5 6.5 0 013.5 6"/>
                    {%- when 'tag' -%}<path d="M3 12V4a1 1 0 011-1h8l9 9-9 9-9-9z"/><circle cx="7.5" cy="7.5" r="1.5"/>
                    {%- else -%}<polyline points="20 6 9 17 4 12"/>
                  {%- endcase -%}
                </svg>
              </div>
            {%- endif -%}
            <h3 class="biab-h3">{{ b.title }}</h3>
            <div class="pc__text">{{ b.text | replace: '[price]', box_price }}</div>
            {%- if b.link_label != blank and link_url != blank -%}
              {%- if b.featured -%}
                <a class="biab-btn biab-btn--gold pc__cta" href="{{ link_url }}">{{ b.link_label }}</a>
              {%- else -%}
                <a class="pc__link" href="{{ link_url }}"{% if b.enquiry_type != blank %} data-partner-type="{{ b.enquiry_type | escape }}"{% endif %}>{{ b.link_label }}</a>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if s.note != blank -%}
        <div class="biab-note">{{ s.note }}</div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Partner — Cards",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor", "info": "Optional ID so buttons can link here, e.g. ways-to-partner." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ways to Partner" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the Right Way to Work with Us" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "4", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "select", "id": "background", "label": "Background", "default": "white", "options": [ { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" } ] },
    { "type": "checkbox", "id": "plain_cards", "label": "Flat cards (no shadow)", "default": false },
    { "type": "richtext", "id": "note", "label": "Note below the cards" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "box", "options": [
          { "value": "none", "label": "None" },
          { "value": "box", "label": "Box" },
          { "value": "store", "label": "Store" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "star", "label": "Star" },
          { "value": "heart", "label": "Heart" },
          { "value": "book", "label": "Book" },
          { "value": "globe", "label": "Globe" },
          { "value": "people", "label": "People" },
          { "value": "tag", "label": "Price tag" },
          { "value": "check", "label": "Tick" }
        ] },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "richtext", "id": "text", "label": "Text", "info": "[price] is replaced with the box price.", "default": "<p>Card description.</p>" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this card", "default": false },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "text", "id": "link_url", "label": "Link", "info": "e.g. /pages/business-in-box. Leave empty with an enquiry type to link to the form." },
        { "type": "text", "id": "enquiry_type", "label": "Enquiry type to preselect", "info": "Must match an option in the enquiry form, e.g. Retail stockist." }
      ]
    }
  ],
  "presets": [{ "name": "Partner — Cards" }]
}
{% endschema %}
