    }
  ],
  "presets": [
    {
      "name": "ZN Problem",
      "blocks": [
        { "type": "stat", "settings": { "number": "1 in 2", "label": "women will have a UTI in their lifetime" } },
        { "type": "stat", "settings": { "number": "1 in 4", "label": "deal with repeat UTIs within 6 months" } }
      ]
    }
  ]
}
{% endschema %}

