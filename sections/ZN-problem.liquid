    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "button_width", "label": "Button max width", "min": 240, "max": 560, "step": 10, "unit": "px", "default": 420 },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E85A34" },
    { "type": "color", "id": "ink_color", "label": "Headings / dark text", "default": "#1A1A1A" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#5F5F5F" },
    { "type": "color", "id": "card_bg", "label": "Stat card background", "default": "#FDEFEB" },
    { "type": "color", "id": "band_bg", "label": "Band background", "default": "#FADDD8" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#FFFFFF" },
    { "type": "text", "id": "font_stack", "label": "Font stack", "default": "'Poppins', 'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 900, "max": 1500, "step": 20, "unit": "px", "default": 1300 },
    { "type": "range", "id": "pad_top", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "pad_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
