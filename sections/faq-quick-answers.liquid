{%- liquid
  assign accent = section.settings.accent_color
  assign icon_bg = section.settings.icon_bg_color
-%}

<style>
  #Faq-{{ section.id }} {
    --faq-accent: {{ accent }};
    --faq-icon-bg: {{ icon_bg }};
    --faq-q: {{ section.settings.question_color }};
    --faq-a: {{ section.settings.answer_color }};
    --faq-card: {{ section.settings.card_color }};
    --faq-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #Faq-{{ section.id }} * { box-sizing: border-box; }

  .faq__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- Header ---------- */
  .faq__eyebrow {
    margin: 0 0 10px;
    text-align: center;
    color: var(--faq-accent);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .22em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .faq__heading {
    margin: 0 0 44px;
    text-align: center;
    color: {{ section.settings.heading_color }};
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  /* ---------- List ---------- */
  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq__item {
    background: var(--faq-card);
    border-radius: var(--faq-radius);
    box-shadow: 0 4px 18px rgba(17, 17, 17, .07);
    transition: box-shadow .25s ease, transform .25s ease;
    overflow: hidden;
  }

  .faq__item:hover {
    box-shadow: 0 8px 26px rgba(17, 17, 17, .11);
  }

  .faq__item.is-open {
    box-shadow: 0 10px 30px {{ accent | color_modify: 'alpha', 0.14 }};
  }

  .faq__q {
    width: 100%;
    margin: 0;
    padding: 10px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--faq-q);
    -webkit-tap-highlight-color: transparent;
    transition: color .2s ease;
  }

  .faq__q:hover { color: var(--faq-accent); }
  .faq__q:focus-visible {
    outline: 3px solid var(--faq-accent);
    outline-offset: -3px;
    border-radius: var(--faq-radius);
  }

  .faq__icon {
    position: relative;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--faq-icon-bg);
    transition: background .25s ease, transform .35s cubic-bezier(.22,.61,.36,1);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--faq-accent);
    border-radius: 2px;
    transition: transform .35s cubic-bezier(.22,.61,.36,1), opacity .25s ease;
  }

  .faq__icon::before {
    width: 13px;
    height: 2.5px;
    transform: translate(-50%, -50%);
  }

  .faq__icon::after {
    width: 2.5px;
    height: 13px;
    transform: translate(-50%, -50%);
  }

  .faq__item.is-open .faq__icon { transform: rotate(180deg); }
  .faq__item.is-open .faq__icon::after { transform: translate(-50%, -50%) scaleY(0); opacity: 0; }

  .faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .38s cubic-bezier(.22,.61,.36,1);
  }

  .faq__item.is-open .faq__panel { grid-template-rows: 1fr; }

  .faq__panel-inner { overflow: hidden; }

  .faq__a {
    margin: 0;
    padding: 0 10px 0px 10px;
    color: var(--faq-a);
    font-size: 16px;
    line-height: 1.65;
    max-width: 100%;
  }

  .faq__a strong { color: var(--faq-q); font-weight: 700; }
  .faq__a a { color: var(--faq-accent); }

  /* ---------- Mobile ---------- */
  @media screen and (max-width: 749px) {
    .faq__inner { padding: 0 18px; }
    .faq__heading { margin-bottom: 30px; }
    .faq__list { gap: 12px; }
    .faq__q {
      padding: 20px 20px;
      gap: 16px;
      font-size: 16px;
    }
    .faq__icon { width: 28px; height: 28px; }
    .faq__icon::before { width: 12px; }
    .faq__icon::after { height: 12px; }
    .faq__a {
      padding: 0 20px 22px;
      font-size: 15px;
      line-height: 1.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__panel, .faq__icon, .faq__icon::before, .faq__icon::after, .faq__item { transition: none !important; }
  }
</style>

<section id="Faq-{{ section.id }}" class="faq">
  <div class="faq__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="faq__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="faq__list" data-faq-list>
      {%- for block in section.blocks -%}
        {%- assign is_open = false -%}
        {%- if section.settings.open_first and forloop.first -%}
          {%- assign is_open = true -%}
        {%- endif -%}

        <div
          class="faq__item{% if is_open %} is-open{% endif %}"
          data-faq-item
          {{ block.shopify_attributes }}
        >
          <button
            class="faq__q"
            type="button"
            data-faq-trigger
            aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
            aria-controls="FaqPanel-{{ section.id }}-{{ block.id }}"
            id="FaqTrigger-{{ section.id }}-{{ block.id }}"
          >
            <span>{{ block.settings.question }}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </button>

          <div
            class="faq__panel"
            id="FaqPanel-{{ section.id }}-{{ block.id }}"
            role="region"
            aria-labelledby="FaqTrigger-{{ section.id }}-{{ block.id }}"
          >
            <div class="faq__panel-inner">
              <div class="faq__a">{{ block.settings.answer }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('Faq-{{ section.id }}');
    if (!root || root.dataset.faqReady === 'true') return;
    root.dataset.faqReady = 'true';

    var single = {{ section.settings.single_open | default: false }};
    var items = Array.prototype.slice.call(root.querySelectorAll('[data-faq-item]'));

    items.forEach(function (item) {
      var trigger = item.querySelector('[data-faq-trigger]');
      if (!trigger) return;

      trigger.addEventListener('click', function () {
        var willOpen = !item.classList.contains('is-open');

        if (single && willOpen) {
          items.forEach(function (other) {
            if (other === item) return;
            other.classList.remove('is-open');
            var t = other.querySelector('[data-faq-trigger]');
            if (t) t.setAttribute('aria-expanded', 'false');
          });
        }

        item.classList.toggle('is-open', willOpen);
        trigger.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      });
    });
  })();
</script>

{%- capture faq_schema -%}
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | strip_html | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | json }} }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
{%- endcapture -%}
<script type="application/ld+json">{{ faq_schema }}</script>

