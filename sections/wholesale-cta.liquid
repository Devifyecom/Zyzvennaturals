{%- comment -%}
  Wholesale CTA ("Apply for Wholesale" banner)
  A rounded brand-colored card with an image either side of a centered heading, a richtext
  body (with an editable inline link) and a button. Every color is a section setting.
  Mobile shows one image above the text (right image by default), or both around it.
  The button link falls back to /pages/wholesale-account-request when left empty.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sel = '#WholesaleCta-' | append: section.id
  assign button_link = s.button_link | default: '/pages/wholesale-account-request'
-%}

{%- style -%}
  {{ sel }} {
    --wsc-bg: {{ s.background_color }};
    --wsc-text: {{ s.text_color }};
    --wsc-btn-bg: {{ s.button_bg }};
    --wsc-btn-text: {{ s.button_text }};
    --wsc-btn-hover-bg: {{ s.button_hover_bg }};
    --wsc-btn-hover-text: {{ s.button_hover_text }};
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  {{ sel }} .wsc__card {
    background: var(--wsc-bg);
    color: var(--wsc-text);
    border-radius: 1.6rem;
    padding: {{ s.card_padding | times: 0.5 | round: 0 }}px 2.8rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }

  {{ sel }} .wsc__media {
    margin: 0;
    border-radius: 1.6rem;
    overflow: hidden;
    aspect-ratio: 4 / 3.5;
    background: rgba(255, 255, 255, 0.15);
  }

  {{ sel }} .wsc__media img,
  {{ sel }} .wsc__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  {{ sel }} .wsc__content {
    text-align: center;
    max-width: 52rem;
    margin: 0 auto;
  }

  {{ sel }} .wsc__heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    color: inherit;
    font-size: 2.8rem;
    line-height: 1.2;
    letter-spacing: 0;
    margin: 0 0 1.6rem;
  }

  {{ sel }} .wsc__body {
    font-size: 1.6rem;
    line-height: 1.55;
    color: inherit;
  }

  {{ sel }} .wsc__body p { margin: 0 0 1em; }
  {{ sel }} .wsc__body p:last-child { margin-bottom: 0; }

  {{ sel }} .wsc__body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  {{ sel }} .wsc__body a:hover { text-decoration-thickness: 2px; }

  {{ sel }} .wsc__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.6rem;
    margin-top: 2.6rem;
    padding: 1rem 2.8rem;
    border-radius: 0.6rem;
    background: var(--wsc-btn-bg);
    color: var(--wsc-btn-text);
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  {{ sel }} .wsc__button:hover {
    background: var(--wsc-btn-hover-bg);
    color: var(--wsc-btn-hover-text);
  }

  {{ sel }} a:focus-visible {
    outline: 2px solid var(--wsc-text);
    outline-offset: 3px;
    box-shadow: none;
  }

  @media screen and (max-width: 749px) {
    {{ sel }} .wsc__media { aspect-ratio: 16 / 9; }
    {{ sel }} .wsc__heading { margin-bottom: 2rem; }
    {{ sel }} .wsc__body { line-height: 1.45; }
    {{ sel }} .wsc__button { margin-top: 2.8rem; min-height: 4.8rem; padding: 1rem 3.2rem; }
    {%- case s.mobile_images -%}
      {%- when 'right' -%}
        {{ sel }} .wsc__media--left { display: none; }
        {{ sel }} .wsc__media--right { order: -1; }
      {%- when 'left' -%}
        {{ sel }} .wsc__media--right { display: none; }
    {%- endcase -%}
  }

  @media screen and (min-width: 750px) {
    {{ sel }} {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }

    {{ sel }} .wsc__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 2.4rem;
      padding: {{ s.card_padding | times: 0.75 | round: 0 }}px 2.4rem;
    }

    {{ sel }} .wsc__heading { font-size: 2.6rem; }
    {{ sel }} .wsc__body { font-size: 1.4rem; }
  }

  @media screen and (min-width: 990px) {
    {{ sel }} .wsc__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1fr);
      gap: clamp(3.2rem, 5vw, 7.6rem);
      padding: {{ s.card_padding }}px clamp(2.4rem, 3vw, 3.8rem);
    }

    {{ sel }} .wsc__heading { font-size: clamp(3rem, 2.8vw, 4rem); }
    {{ sel }} .wsc__body { font-size: 1.7rem; }
  }
{%- endstyle -%}

<div id="WholesaleCta-{{ section.id }}" class="wsc">
  <div class="page-width">
    <div class="wsc__card">
      <div class="wsc__media wsc__media--left">
        {%- if s.image_left != blank -%}
          {{
            s.image_left
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 990px) 30vw, (min-width: 750px) 28vw, 100vw',
              alt: s.image_left.alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="wsc__content">
        {%- if s.heading != blank -%}
          <h2 class="wsc__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.body != blank -%}
          <div class="wsc__body">{{ s.body }}</div>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="wsc__button" href="{{ button_link }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
      </div>

      <div class="wsc__media wsc__media--right">
        {%- if s.image_right != blank -%}
          {{
            s.image_right
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 990px) 30vw, (min-width: 750px) 28vw, 100vw',
              alt: s.image_right.alt
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wholesale CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_left", "label": "Left image", "info": "Alt text comes from the image's alt text in Files." },
    { "type": "image_picker", "id": "image_right", "label": "Right image" },
    {
      "type": "select",
      "id": "mobile_images",
      "label": "Mobile images",
      "options": [
        { "value": "right", "label": "Right image only, above text" },
        { "value": "left", "label": "Left image only, above text" },
        { "value": "both", "label": "Both, above and below text" }
      ],
      "default": "right"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apply for Wholesale" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>We welcome partnerships with retailers who share our passion for natural wellness. To apply for wholesale, visit our <a href=\"/pages/wholesale-account-request\" title=\"Wholesale Application Page\">Wholesale Application Page</a> and complete the form with your business details. Once your application is reviewed and approved, you’ll gain access to exclusive pricing, bulk ordering, and dedicated support.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start now" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to /pages/wholesale-account-request when empty." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Card background", "default": "#358440" },
    { "type": "color", "id": "text_color", "label": "Card text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#1C1C1C" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#2A6A33" },
    { "type": "color", "id": "button_hover_text", "label": "Button hover text", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "card_padding", "label": "Card padding (top/bottom)", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_top", "label": "Section padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Section padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 }
  ],
  "presets": [{ "name": "Wholesale CTA" }]
}
{% endschema %}
