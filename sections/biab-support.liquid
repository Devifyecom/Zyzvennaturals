{{ 'biab.css' | asset_url | stylesheet_tag }}

{%- liquid assign s = section.settings -%}

<div class="biab biab--white">
  <section class="biab-section" id="biab-support" aria-labelledby="biab-support-title">
    <div class="biab-inner">
      <div class="biab-head">
        {%- if s.eyebrow != blank -%}<p class="biab-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="biab-h2" id="biab-support-title">{{ s.heading }}</h2>
        <hr class="biab-rule">
        {%- if s.subheading != blank -%}<p class="biab-lede">{{ s.subheading }}</p>{%- endif -%}
      </div>

      <div class="biab-grid biab-grid--3">
        {%- for block in section.blocks -%}
          <div class="biab-card" {{ block.shopify_attributes }}>
            <div class="biab-support__icon">
              {%- case block.settings.icon -%}
                {%- when 'training' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4-9 4z"/><path d="M7 10v5c0 1.7 2.2 3 5 3s5-1.3 5-3v-5"/><path d="M21 7v6"/></svg>
                {%- when 'toolkit' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2M3 12h18"/></svg>
                {%- when 'calendar' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                {%- when 'tag' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="7.5" r="1.4"/></svg>
                {%- when 'community' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0113 0"/><path d="M16 5.5a3.2 3.2 0 010 6M18 20a6.4 6.4 0 00-2.5-5"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.5 5.5L20 10l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-1.5z"/></svg>
              {%- endcase -%}
            </div>
            <h3 class="biab-h3">{{ block.settings.title }}</h3>
            <p class="biab-body">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "BIAB — Support",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You're Supported Beyond the Box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You Won't Be Left Alone After You Buy" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The box is the starting point. What follows is the part that decides whether the business works." }
  ],
  "blocks": [
    {
      "type": "support",
      "name": "Support card",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "training",
          "options": [
            { "value": "training", "label": "Training" },
            { "value": "toolkit", "label": "Marketing toolkit" },
            { "value": "calendar", "label": "Check-ins" },
            { "value": "tag", "label": "Reseller pricing" },
            { "value": "community", "label": "Community" },
            { "value": "star", "label": "Other" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Support title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "What this means in practice." }
      ]
    }
  ],
  "presets": [
    {
      "name": "BIAB — Support",
      "blocks": [
        { "type": "support", "settings": { "icon": "training", "title": "Product training", "text": "Learn what each product is, who it is for, and how to present it responsibly — so you can answer customer questions with confidence and stay within the claims we permit." } },
        { "type": "support", "settings": { "icon": "toolkit", "title": "Marketing toolkit", "text": "Approved product images, written descriptions and promotional and social launch materials, ready to use. No need to photograph stock or write copy from scratch." } },
        { "type": "support", "settings": { "icon": "calendar", "title": "Monthly check-ins", "text": "Ongoing product education, practical business guidance and a live Q&A where you can bring real situations from your own selling." } },
        { "type": "support", "settings": { "icon": "tag", "title": "Reseller pricing", "text": "Reorder individual products at reseller pricing without buying another full box, so you can restock what actually sells in your market." } },
        { "type": "support", "settings": { "icon": "community", "title": "International community", "text": "Join the growing Zyzven Naturals reseller and distributor network across Jamaica, the USA, the UK, Sweden and Canada." } }
      ]
    }
  ]
}
{% endschema %}
