{% style %}
    .section-{{ section.id }} {
        padding-top: {{ section.settings.pad_top }}px;
        padding-bottom: {{ section.settings.pad_bottom }}px;
    }

    .section-{{ section.id }} .image-text {
        display: flex;
        gap: 80px;
        align-items: center;
    }

    .section-{{ section.id }} .image-content {
        width: 60%;
        display: flex;
        flex-direction: column;
        gap: 50px;
    }

    .section-{{ section.id }} .image-content h2 {
        font-size: 40px;
        line-height: 51px;
        color: #283613;
        font-weight: 600;
        font-family: "Golos Text", sans-serif;
        margin: 0;
    }

    .section-{{ section.id }} .image-blocks {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .section-{{ section.id }} .image-text > img {
        width: 40%;
    }

    .section-{{ section.id }} .image-block {
        display: flex;
        align-items: center;
        gap: 30px;
    }

    .section-{{ section.id }} .image-block img {
        height: 70px;
        width: auto;
    }

    .section-{{ section.id }} .image-block p {
        font-size: 20px;
        line-height: 30px;
        margin: 0;
    }

    @media screen and (max-width: 1025px) {
        .section-{{ section.id }} .image-text {
            gap: 50px;
        }

        .section-{{ section.id }} .image-content {
            gap: 30px;
        }

        .section-{{ section.id }} .image-content h2 {
            font-size: 30px;
            line-height: 40px;
        }

        .section-{{ section.id }} .image-block img {
            height: 50px;
        }

        .section-{{ section.id }} .image-block p {
            font-size: 16px;
            line-height: 20px;
        }
    }

    @media screen and (max-width: 750px) {
        .section-{{ section.id }} {
            padding-top: {{ section.settings.pad_top | divided_by: 2 }}px;
            padding-bottom: {{ section.settings.pad_bottom | divided_by: 2 }}px;
        }

        .section-{{ section.id }} .image-content {
            gap: 15px;
            width: 100%;
            text-align: center;
        }

        .section-{{ section.id }} .image-content h2 {
            font-size: 24px;
        }

        .section-{{ section.id }} .image-blocks {
            gap: 20px;
            margin-bottom: 20px;
        }

        .section-{{ section.id }} .image-block {
            flex-direction: column;
            justify-content: center;
            gap: 10px;
        }
    }
{% endstyle %}

<div class="section-{{ section.id }} page-width">
    <div class="image-text">
        <div class="image-content">
            <h2>{{ section.settings.heading }}</h2>
            <div class="image-blocks">
                {% for block in section.blocks %}
                    <div class="image-block">
                        <img src="{{ section.settings.icon | img_url: 'master' }}" width="100%" height="100%" alt="{{ section.settings.icon.alt }}">
                        <p>{{ block.settings.info }}</p>
                    </div>
                {% endfor %}
            </div>
            <img src="{{ section.settings.marks | img_url: 'master' }}" width="100%" height="100%" alt="{{ section.settings.marks.alt }}">
        </div>
        <img src="{{ section.settings.image | img_url: 'master' }}" width="100%" height="100%" alt="{{ section.settings.image.alt }}" class="desktop">
    </div>
</div>

{% schema %}
{
    "name": "Home Image Text",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
        },
        {
            "type": "image_picker",
            "id": "marks",
            "label": "Marks"
        },
        {
            "type": "range",
            "id": "pad_top",
            "label": "Padding Top",
            "min": 0,
            "max": 100,
            "step": 5,
            "default": 0,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "pad_bottom",
            "label": "Padding Bottom",
            "min": 0,
            "max": 100,
            "step": 5,
            "default": 0,
            "unit": "px"
        }
    ],
    "blocks": [
        {
            "type": "block",
            "name": "Block",
            "settings": [
                {
                    "type": "text",
                    "id": "info",
                    "label": "Info"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Home Image Text"
        }
    ]
}
{% endschema %}