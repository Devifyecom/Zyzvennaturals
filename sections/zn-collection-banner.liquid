    { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#1d3029" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 20, "max": 95, "step": 5, "unit": "%", "default": 80 },

    { "type": "header", "content": "Quick links" },
    { "type": "text", "id": "links_heading", "label": "Quick links heading", "default": "Browse" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f6f1e8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1f2f29" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#b08f6c" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#27423a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "limit": 4,
      "settings": [
