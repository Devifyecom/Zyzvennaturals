<div class="wellness-circle-section">
  <div class="page-width">

    <!-- Heading -->
    <h2 class="wellness-title">
      {{ section.settings.heading }}
    </h2>

    <!-- Divider -->
   <div class="newsletter-divider">
  <span></span>
  <img src="https://cdn.shopify.com/s/files/1/0245/2422/6606/files/logozynn.png?v=1772427108" alt="Logo">
  <span></span>
</div>
    <!-- Green Bar -->
    <div class="wellness-features">
      <span>{{ section.settings.feature_1 }}</span>
      <span class="divider-line">|</span>
      <span>{{ section.settings.feature_2 }}</span>
      <span class="divider-line">|</span>
      <span>{{ section.settings.feature_3 }}</span>
    </div>

    <!-- Button -->
    <div class="wellness-btn-wrapper">
      <a href="{{ section.settings.button_link }}" class="pszyenbtn wellness-btn">
        {{ section.settings.button_text }}
      </a>
    </div>

  </div>
</div>

<style>
.wellness-circle-section {
  padding: 80px 20px;
  background: #F6F3ED;
  text-align: center;
}

.wellness-title {
  font-family: 'Marcellus', serif;
  font-size: 35px;
  margin-bottom: 10px;
}

/* Green Bar */
.wellness-features {
     display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    background: #27A45E;
    color: #fff;
    padding: 9px 27px;
    border-radius: 10px;
    box-shadow: 0px 0px 4px 0px #00000040;
    font-size: 20px;
    letter-spacing: 1px;
    font-weight: 500;
    margin: 0px auto 14px;
    flex-wrap: wrap;
    text-align: center;
    height: 54px;
}

.wellness-features span {
  white-space: nowrap;
}

.divider-line {
  opacity: 0.6;
}

/* Button */
.wellness-btn {
{% comment %} background: #358440; {% endcomment %}
    color: #fff;
    padding: 7px 40px;
    text-decoration: none;
    font-size: 18px;
    letter-spacing: 1px;
    display: inline-block;
    font-family: "Poppins", sans-serif;
    transition: 0.3s ease;
    height: 45px;
}

.wellness-btn:hover {
  opacity: 0.85;
  color: #fff;
  {% comment %} background: #358440; {% endcomment %}
}

/* ========================= */
/* Tablet */
@media (max-width: 1024px) {

  .wellness-title {
    font-size: 30px;
  }

  .wellness-features {
    font-size: 17px;
    padding: 16px 28px;
    gap: 18px;
  }

}

/* ========================= */
/* Mobile */
@media (max-width: 600px) {

  .wellness-circle-section {
    padding: 60px 15px;
  }

  .wellness-title {
    font-size: 24px;
  }



  .wellness-features {
    white-space: normal !important;
    overflow-wrap: break-word;
    word-break: break-word;
    text-align: center;
    font-size: 13px;
            height: max-content;
  }


  .divider-line {
    display: none;
  }

  .wellness-btn {
    width: 100%;
    max-width: 280px;
    font-size: 12px;
    padding: 11px 32px ;
  }

}
</style>

{% schema %}
{
  "name": "Wellness Circle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "The Zyzven Wellness Circle",
      "label": "Heading"
    },

    {
      "type": "text",
      "id": "feature_1",
      "default": "STRUCTURED ACCESS",
      "label": "Feature 1"
    },
    {
      "type": "text",
      "id": "feature_2",
      "default": "FOUNDER-LED EDUCATION",
      "label": "Feature 2"
    },
    {
      "type": "text",
      "id": "feature_3",
      "default": "PRIORITY SUPPORT",
      "label": "Feature 3"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "EXPLORE MEMBERSHIP",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Wellness Circle"
    }
  ]
}
{% endschema %}