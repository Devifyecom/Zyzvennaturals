{{ 'bib.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign promo_url = s.cta_link | default: '/pages/business-in-box'

  assign grid_class = 'bib-promo__grid'
  if s.image != blank
    assign grid_class = 'bib-promo__grid bib-promo__grid--with-media'
  endif
-%}

<section class="bib bib-promo" style="--bib-promo-bg: {{ s.background_color }};">
  <div class="bib__inner">
    <div class="{{ grid_class }}">
      <div class="bib-promo__content">
        <h2 class="bib-promo__h2">{{ s.heading }}</h2>

        {%- if s.body != blank -%}
          <p class="bib-promo__body">{{ s.body }}</p>
        {%- endif -%}

        {%- if s.price_line != blank -%}
          <p class="bib-promo__price">{{ s.price_line }}</p>
        {%- endif -%}

        <a href="{{ promo_url }}" class="bib-btn bib-promo__cta" data-bib-cta="homepage-promo">
          {{ s.cta_label }}
        </a>
      </div>

      {%- if s.image != blank -%}
        <div class="bib-promo__media">
          {{
            s.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 700, 900',
              sizes: '(min-width: 990px) 40vw, 100vw',
              alt: s.image_alt
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BIB — Homepage promo",
  "tag": "section",
  "class": "bib-promo-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Your Wellness Business. Ready in One Box."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "40 ready-to-retail Zyzven Naturals products with a combined recommended retail value of over $2,000 for $999 + shipping."
    },
    {
      "type": "text",
      "id": "price_line",
      "label": "Price line",
      "default": "Training, marketing toolkit and monthly support included · Wholesale, not MLM"
    },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Explore Business in a Box →" },
    { "type": "url", "id": "cta_link", "label": "CTA link", "info": "Defaults to /pages/business-in-box" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Without one the text runs full width." },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Zyzven Naturals Business in a Box reseller starter package with 40 teas and supplements."
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F5F4EE" }
  ],
  "presets": [{ "name": "BIB — Homepage promo" }]
}
{% endschema %}

