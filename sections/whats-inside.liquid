{%- liquid
  assign accent = section.settings.accent_color
-%}

<style>
  #Inside-{{ section.id }} {
    --in-accent: {{ accent }};
    --in-accent-dark: {{ accent | color_darken: 7 }};
    --in-border: {{ section.settings.card_border_color }};
    --in-heading: {{ section.settings.heading_color }};
    --in-body: {{ section.settings.body_color }};
    --in-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #Inside-{{ section.id }} * { box-sizing: border-box; }

  .in__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- Header ---------- */
  .in__eyebrow {
    margin: 0 0 12px;
    text-align: center;
    color: var(--in-accent);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .2em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .in__heading {
    margin: 0 auto;
    text-align: center;
    color: var(--in-heading);
    font-size: clamp(28px, 3.6vw, 46px);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .in__lead {
    margin: 22px auto 0;
    max-width: {{ section.settings.lead_width }}px;
    text-align: center;
    color: var(--in-body);
    font-size: clamp(15px, 1.35vw, 17.5px);
    line-height: 1.6;
  }

  /* ---------- Cards ---------- */
  .in__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
    margin: {{ section.settings.grid_gap | plus: 20 }}px 0 0;
  }

  .in__card {
    background: {{ section.settings.card_color }};
    border: 1px solid var(--in-border);
    border-radius: var(--in-radius);
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(0, 0, 0, .07);
    display: flex;
    flex-direction: column;
    transition: transform .3s cubic-bezier(.22,.61,.36,1), box-shadow .3s ease, border-color .3s ease;
  }

  .in__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 34px rgba(0, 0, 0, .11);
    border-color: {{ accent | color_modify: 'alpha', 0.3 }};
  }

  .in__media {
    aspect-ratio: 1;
    background: {{ section.settings.media_background }};
    overflow: hidden;
  }

  .in__media img,
  .in__media svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
    transition: transform .5s cubic-bezier(.22,.61,.36,1);
  }

  .in__card:hover .in__media img { transform: scale(1.04); }

  .in__body {
    padding: 18px;
    text-align: center;
    flex: 1 1 auto;
  }

  .in__name {
    font-size: 16px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--in-heading);
    margin: 0 0 2px;
  }

  .in__dose {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--in-accent);
    margin: 0 0 10px;
  }

  .in__desc {
    font-size: 13px;
    color: var(--in-body);
    line-height: 1.5;
    margin: 0;
  }

  /* ---------- Note ---------- */
  .in__note {
    background: {{ section.settings.note_background }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 24px;
    text-align: center;
    max-width: {{ section.settings.note_width }}px;
    margin: {{ section.settings.grid_gap | plus: 20 }}px auto 0;
  }

  .in__note p {
    margin: 0;
    font-size: 15px;
    color: {{ section.settings.note_text_color }};
    line-height: 1.6;
  }

  .in__note strong { font-weight: 800; }
  .in__note em { font-style: italic; }

  /* ---------- CTA ---------- */
  .in__cta-wrap { text-align: center; margin-top: 26px; }

  .in__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: {{ section.settings.button_width }}px;
    padding: 21px 32px;
    border: 0;
    border-radius: 999px;
    background: var(--in-accent);
    color: #fff;
    font-family: inherit;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 10px 26px {{ accent | color_modify: 'alpha', 0.32 }};
    transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
  }

  .in__cta:hover {
    background: var(--in-accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 14px 32px {{ accent | color_modify: 'alpha', 0.38 }};
  }

  .in__cta:active { transform: translateY(0); }
  .in__cta:focus-visible { outline: 3px solid var(--in-heading); outline-offset: 3px; }

  /* ---------- Scroll reveal ---------- */
  .in__reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .6s cubic-bezier(.22,.61,.36,1), transform .6s cubic-bezier(.22,.61,.36,1);
  }

  .in__reveal.is-in { opacity: 1; transform: none; }

  /* ---------- Responsive ---------- */
  @media screen and (max-width: 1099px) {
    .in__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 749px) {
    .in__inner { padding: 0 18px; }
    .in__lead { margin-top: 16px; font-size: 15px; }
    .in__grid { gap: 12px; }
    .in__body { padding: 16px 14px; }
    .in__desc { font-size: 12.5px; }
    .in__note { padding: 20px 18px; }
    .in__note p { font-size: 14.5px; }
    .in__cta { max-width: none; font-size: 16px; padding: 19px 24px; }
  }

  @media screen and (max-width: 419px) {
    .in__grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .in__reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    .in__card, .in__media img, .in__cta { transition: none !important; }
  }
</style>

<section id="Inside-{{ section.id }}" class="in">
  <div class="in__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="in__eyebrow in__reveal" data-in-reveal>{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="in__heading in__reveal" data-in-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.lead != blank -%}
      <p class="in__lead in__reveal" data-in-reveal>{{ section.settings.lead }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="in__grid">
        {%- for block in section.blocks -%}
          <article class="in__card in__reveal" data-in-reveal {{ block.shopify_attributes }}>
            <div class="in__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  srcset="{{ block.settings.image | image_url: width: 350 }} 350w,
                          {{ block.settings.image | image_url: width: 700 }} 700w"
                  sizes="(max-width: 419px) calc(100vw - 36px), (max-width: 1099px) 45vw, {{ section.settings.max_width | divided_by: section.settings.columns }}px"
                  alt="{{ block.settings.image.alt | default: block.settings.name | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  decoding="async"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: '' }}
              {%- endif -%}
            </div>

            <div class="in__body">
              {%- if block.settings.name != blank -%}
                <h3 class="in__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.dose != blank -%}
                <p class="in__dose">{{ block.settings.dose }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="in__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <div class="in__note in__reveal" data-in-reveal>{{ section.settings.note }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="in__cta-wrap in__reveal" data-in-reveal>
        {%- if section.settings.button_link != blank -%}
          <a class="in__cta" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
            <span aria-hidden="true">&rarr;</span>
          </a>
        {%- else -%}
          <button class="in__cta" type="button" data-in-buy>
            {{ section.settings.button_label }}
            <span aria-hidden="true">&rarr;</span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('Inside-{{ section.id }}');
    if (!root || root.dataset.inReady === 'true') return;
    root.dataset.inReady = 'true';

    /* Staggered scroll reveal */
    var targets = Array.prototype.slice.call(root.querySelectorAll('[data-in-reveal]'));
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduce || !('IntersectionObserver' in window)) {
      targets.forEach(function (el) { el.classList.add('is-in'); });
    } else {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target;
          var group = el.parentElement && el.parentElement.classList.contains('in__grid');
          var delay = group ? Array.prototype.indexOf.call(el.parentElement.children, el) * 90 : 0;
          el.style.transitionDelay = delay + 'ms';
          el.classList.add('is-in');
          observer.unobserve(el);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });

      targets.forEach(function (el) { observer.observe(el); });
    }

    /* Keeps the original hgBuy() behaviour when no link is set */
    var buyBtn = root.querySelector('[data-in-buy]');
    if (buyBtn) {
      buyBtn.addEventListener('click', function () {
        if (typeof window.hgBuy === 'function') { window.hgBuy(); return; }
        var form = document.querySelector('form[action*="/cart/add"]');
        if (form) {
          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
          var submit = form.querySelector('[type="submit"]');
          if (submit) submit.focus({ preventScroll: true });
        }
      });
    }

    document.addEventListener('shopify:section:select', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        targets.forEach(function (el) { el.classList.add('is-in'); });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "What's inside",
  "tag": "section",
  "class": "section-whats-inside",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two Capsules. Total Bladder Support." },
    { "type": "textarea", "id": "lead", "label": "Intro text", "default": "Zyzven Naturals D-Mannose isn't another cranberry pill that does nothing. It's natural actives that flush, soothe, and support your urinary tract at once." },
    { "type": "richtext", "id": "note", "label": "Callout note", "default": "<p><strong>The difference:</strong> most cranberry pills are underdosed and stop at one ingredient. Zyzven Naturals leads with a real 1,000mg of D-Mannose, then layers in Cranberry, Hibiscus, and Dandelion. You get the flush <em>and</em> the daily support, not a token dose.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Flushing" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to scroll to the product form instead." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "min": 900, "max": 1400, "step": 20, "label": "Max width", "default": 1160, "unit": "px" },
    { "type": "range", "id": "lead_width", "min": 480, "max": 1000, "step": 20, "label": "Intro text width", "default": 780, "unit": "px" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "range", "id": "grid_gap", "min": 8, "max": 40, "step": 2, "label": "Grid gap", "default": 14, "unit": "px" },
    { "type": "range", "id": "card_radius", "min": 0, "max": 32, "step": 2, "label": "Corner radius", "default": 16, "unit": "px" },
    { "type": "range", "id": "note_width", "min": 500, "max": 1000, "step": 20, "label": "Callout width", "default": 720, "unit": "px" },
    { "type": "range", "id": "button_width", "min": 200, "max": 480, "step": 10, "label": "Button width", "default": 300, "unit": "px" },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill the square (cover)" },
        { "value": "contain", "label": "Fit inside (contain)" }
      ],
      "default": "cover"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "label": "Padding top", "default": 72, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "label": "Padding bottom", "default": 72, "unit": "px" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E8532B" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#121212" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#5F5F6B" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#ECECEC" },
    { "type": "color", "id": "media_background", "label": "Image background", "default": "#FFFFFF" },
    { "type": "color", "id": "note_background", "label": "Callout background", "default": "#F9E1DC" },
    { "type": "color", "id": "note_text_color", "label": "Callout text", "default": "#2B2B2B" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "D-Mannose" },
        { "type": "text", "id": "dose", "label": "Dose", "default": "1,000mg" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Keeps UTI-causing bacteria from sticking to your bladder wall, so your body flushes it out." }
      ]
    }
  ],
  "presets": [
    {
      "name": "What's inside",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "D-Mannose",
            "dose": "1,000mg",
            "description": "Keeps UTI-causing bacteria from sticking to your bladder wall, so your body flushes it out."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Cranberry Extract",
            "dose": "250mg",
            "description": "Concentrated cranberry without the juice sugar. Its PACs support a healthy urinary tract."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Hibiscus",
            "dose": "75mg",
            "description": "Traditionally used for urinary and kidney support, it helps calm an irritated bladder."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Dandelion",
            "dose": "75mg",
            "description": "A gentle natural diuretic that supports your kidneys and the daily flushing that keeps bacteria out."
          }
        }
      ]
    }
  ]
}
{% endschema %}

