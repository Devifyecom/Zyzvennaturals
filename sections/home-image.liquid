{% style %}
    .section-{{ section.id }} {
        position: relative;
    }

    @media screen and (min-width: 750px) {
        .section-{{ section.id }} > img.desktop {
            display: block;
        }
    }

    .section-{{ section.id }} .home-image {
        position: absolute;
        top: 50%;
        transform: translate(0, -50%);
        width: 50%;
        padding-right: 0;
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .section-{{ section.id }} .home-block {
        display: flex;
        align-items: center;
        gap: 30px;
    }

    .section-{{ section.id }} .home-number {
        width: 80px;
        height: 80px;
        background: #31853c;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .section-{{ section.id }} .home-number span {
        font-size: 40px;
        line-height: 51px;
        font-family: "Golos Text", sans-serif;
        color: white;
        font-weight: 600;
    }

    .section-{{ section.id }} .home-info {
        width: calc(100% - 148px);
    }

    .section-{{ section.id }} .home-info h2 {
        margin: 0;
        font-size: 36px;
        line-height: 51px;
        color: #31853c;
        font-weight: 600;
        font-family: "Golos Text", sans-serif;
    }

    .section-{{ section.id }} .home-info p {
        margin: 0;
        color: #283613;
    }

    .section-{{ section.id }} .block-line {
        height: calc(100% - 118px);
        width: 3px;
        background: #31853c;
        display: block;
        position: absolute;
        top: 60px;
        left: 85px;
        z-index: -1;
    }

    .section-{{ section.id }} .mobile-logo {
        position: absolute;
        bottom: 200px;
        left: 40px;
        height: 90px;
        width: auto;
    }

    @media screen and (max-width: 1250px) {
        .section-{{ section.id }} .home-number {
            width: 70px;
            height: 70px;
        }

        .section-{{ section.id }} .home-number span {
            font-size: 30px;
        }

        .section-{{ section.id }} .home-info {
            width: calc(100% - 100px);
        }

        .section-{{ section.id }} .home-info h2 {
            font-size: 24px;
            line-height: 30px;
        }

        .section-{{ section.id }} .home-info p {
            font-size: 14px;
            line-height: 18px;
        }

        .section-{{ section.id }} .block-line {
            top: 35px;
            left: 85px;
            height: calc(100% - 70px);
        }
    }

    @media screen and (max-width: 750px) {
        .section-{{ section.id }} .home-image {
            width: 100%;
            top: 30px;
            transform: none;
            gap: 10px;
        }

        .section-{{ section.id }} .home-block {
            gap: 20px;
        }
        
        .section-{{ section.id }} .home-number {
            width: 60px;
            height: 60px;
        }
        
        .section-{{ section.id }} .home-number span {
            font-size: 24px;
        }

        .section-{{ section.id }} .home-info {
            width: calc(100% - 80px);
        }

        .section-{{ section.id }} .home-info h2 {
            font-size: 20px;
        }

        .section-{{ section.id }} .block-line {
            top: 30px;
            left: 45px;
            height: calc(100% - 60px);
        }
    }
{% endstyle %}

<div class="section-{{ section.id }}">
    <img src="{{ section.settings.image | img_url: 'master' }}" width="100%" height="100%" alt="{{ section.settings.image.alt }}" class="desktop">
    <img src="{{ section.settings.image_mobile1 | img_url: 'master' }}" width="100%" height="100%" alt="{{ section.settings.image_mobile1.alt }}" class="mobile" style="position: relative; z-index: -1;">
    <img src="{{ section.settings.image_mobile2 | img_url: 'master' }}" width="100%" height="100%" alt="{{ section.settings.image_mobile2.alt }}" class="mobile" style="margin-top: -100px">
    <div class="home-image page-width">
        {% for block in section.blocks %}
            <div class="home-block">
                <div class="home-number"><span>{{ block.settings.number }}</span></div>
                <div class="home-info">
                    <h2>{{ block.settings.title }}</h2>
                    <p>{{ block.settings.content }}</p>
                </div>
            </div>
        {% endfor %}
        <div class="block-line"></div>
    </div>
    <img src="{{ section.settings.mobile_logo | img_url: 'master' }}" width="100%" height="100%" alt="{{ section.settings.mobile_logo.alt }}" class="mobile mobile-logo">
</div>

{% schema %}
{
    "name": "Home Image",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "image_picker",
            "id": "image_mobile1",
            "label": "Image Mobile1"
        },
        {
            "type": "image_picker",
            "id": "image_mobile2",
            "label": "Image Mobile2"
        },
        {
            "type": "image_picker",
            "id": "mobile_logo",
            "label": "Mobile Logo"
        }
    ],
    "blocks": [
        {
            "type": "block",
            "name": "Block",
            "settings": [
                {
                    "type": "text",
                    "id": "number",
                    "label": "Number"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },
                {
                    "type": "text",
                    "id": "content",
                    "label": "Content"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Home Image"
        }
    ]
}
{% endschema %}