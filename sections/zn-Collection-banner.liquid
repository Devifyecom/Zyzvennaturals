{%- comment -%}
  Collection Banner (banner only)
  - On a collection page: uses the current collection automatically.
  - Elsewhere: uses the collection picked in the editor.
  - Title, description and product count are fetched from Shopify.
  - Background: image picked in editor, otherwise the default Zyzven banner image.
{%- endcomment -%}

{%- liquid
  assign c = collection
  if template.name != 'collection' and section.settings.collection != blank
    assign c = section.settings.collection
  endif
  assign default_bg = 'https://zyzvennaturals.com/cdn/shop/files/WhatsApp_Image_2026-09-23_at_1.02.05_PM.jpg?v=1790147980&width=2400'
  assign overlay_opacity = section.settings.overlay | times: 1.0 | divided_by: 100
-%}

{%- if c != blank -%}
<section class="zcb zcb-{{ section.id }}" style="--zcb-accent: {{ section.settings.accent }};">
  <div class="zcb__hero" style="min-height: {{ section.settings.height }}px;">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'zcb__img', loading: 'eager', sizes: '100vw', widths: '600, 900, 1200, 1800, 2400', alt: c.title }}
    {%- else -%}
      <img class="zcb__img" src="{{ default_bg }}" alt="{{ c.title | escape }}" loading="eager">
    {%- endif -%}
    <div class="zcb__overlay zcb__overlay--{{ section.settings.overlay_style }}" style="--zcb-ov-color: {{ section.settings.overlay_color }}; opacity: {{ overlay_opacity }};"></div>
    <div class="zcb__content zcb__content--{{ section.settings.align }}">
      {%- if section.settings.show_count -%}
        <span class="zcb__eyebrow">{{ c.all_products_count }} {{ c.all_products_count | pluralize: 'product', 'products' }}</span>
      {%- endif -%}
      <h1 class="zcb__title">{{ c.title }}</h1>
      {%- if section.settings.show_description and c.description != blank -%}
        <div class="zcb__desc">{{ c.description | strip_html | truncatewords: 30 }}</div>
      {%- endif -%}
      {%- if template.name != 'collection' -%}
        <a href="{{ c.url }}" class="zcb__btn">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

<style>
  .zcb .zcb__hero{position:relative !important;display:flex;align-items:center;overflow:hidden;background:#2f3d2c}
  .zcb .zcb__img{position:absolute !important;inset:0;width:100% !important;height:100% !important;max-width:none;object-fit:cover;z-index:0}
  .zcb .zcb__overlay{position:absolute !important;inset:0;z-index:1;pointer-events:none;background:var(--zcb-ov-color,#000)}
  .zcb .zcb__overlay--gradient{background:linear-gradient(90deg,var(--zcb-ov-color,#000) 0%,var(--zcb-ov-color,#000) 30%,transparent 100%)}
  .zcb .zcb__content{position:relative;z-index:2;color:#fff;padding:48px 5vw;max-width:760px;width:100%}
  .zcb .zcb__content--center{margin:0 auto;text-align:center}
  .zcb .zcb__content--right{margin-left:auto;text-align:right}
  .zcb .zcb__eyebrow{display:inline-block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;background:rgba(255,255,255,.18);backdrop-filter:blur(6px);padding:6px 12px;border-radius:999px;margin-bottom:14px}
  .zcb .zcb__title{font-size:clamp(32px,5vw,56px);line-height:1.05;margin:0 0 12px;color:#fff}
  .zcb .zcb__desc{font-size:16px;line-height:1.6;opacity:.92;margin-bottom:20px}
  .zcb .zcb__btn{display:inline-block;background:var(--zcb-accent);color:#fff;padding:13px 26px;border-radius:999px;text-decoration:none;font-weight:600;transition:transform .2s,opacity .2s}
  .zcb .zcb__btn:hover{transform:translateY(-2px);opacity:.92}
  @media (max-width:749px){
    .zcb .zcb__hero{min-height:360px !important}
    .zcb .zcb__content{padding:32px 16px}
    .zcb .zcb__overlay--gradient{background:var(--zcb-ov-color,#000)}
  }
</style>

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used outside collection pages. On a collection page, the current collection is used automatically." },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Leave empty to use the default Zyzven banner image." },
    { "type": "range", "id": "height", "min": 300, "max": 700, "step": 20, "unit": "px", "label": "Banner height", "default": 460 },
    { "type": "header", "content": "Overlay" },
    { "type": "range", "id": "overlay", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Overlay darkness", "default": 45 },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "select", "id": "overlay_style", "label": "Overlay style", "default": "solid", "options": [
      { "value": "solid", "label": "Solid (even)" },
      { "value": "gradient", "label": "Gradient (dark left, clear right)" } ] },
    { "type": "header", "content": "Content" },
    { "type": "select", "id": "align", "label": "Text alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#5a7a4a" }
  ],
  "presets": [{ "name": "Collection banner" }]
}
{% endschema %}

