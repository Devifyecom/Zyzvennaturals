{% comment %} {% stylesheet %}

.manufacturing-features {
  padding: 60px 0;
}

.manufacturing-features-wrapper {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
  font-family: "Inter";
}

/* .feature-card {
  background: #EFEFEA;
  padding: 24px 20px 28px;

} */
.feature-card {
    background: #e8f5e9;
    width: 100%;
    min-height: 158px;
    padding: 2px 5px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
}
.feature-header {
  display: flex;
  align-items: center;
  gap: 14px;
}

.feature-icon {
  flex-shrink: 0;
  width: 55px;
  height: 55px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon img {
  width: 55px;
  height: 55px;
  object-fit: contain;
}

.feature-title {
  font-family: inherit;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.3;
  color: #1a1a1a;
  margin: 0;
}

.feature-description {
font-size: 12px;
    font-weight: 200;
    color: #000;
    line-height: 1.5;
    margin-top: 5px;
    padding: 1px;
}

.feature-subtext {
  font-size: 10px;
  color: #4a4a4a;
  line-height: 1.6;
   padding: 1px;
}

@media screen and (max-width: 1200px) {
  .manufacturing-features-wrapper {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media screen and (max-width: 768px) {
  .manufacturing-features-wrapper {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (max-width: 480px) {
  .manufacturing-features-wrapper {
    grid-template-columns: repeat(1, 1fr);
  }
}
{% endstylesheet %}

<section class="manufacturing-features">
  <div class="page-width">
    <div class="manufacturing-features-wrapper">

      {% for block in section.blocks %}
        <div class="feature-card" {{ block.shopify_attributes }}>

          <div class="feature-header">
            {% if block.settings.icon != blank %}
              <div class="feature-icon">
                <img
                  src="{{ block.settings.icon | image_url: width: 100 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}

            <div class="feature-title">
              {{ block.settings.title }}
            </div>
          </div>

          {% if block.settings.description != blank %}
            <div class="feature-description">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.subtext != blank %}
            <div class="feature-subtext">
              {{ block.settings.subtext }}
            </div>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manufacturing Features",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
