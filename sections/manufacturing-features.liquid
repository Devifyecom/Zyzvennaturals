{% stylesheet %}

.manufacturing-features {
  padding: 20px 0;
}

.manufacturing-features-wrapper {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
  font-family: "Inter";
}

.feature-card {
  background: #e8f5e9;
  width: 100%;
  min-height: 158px;
  padding: 10px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.feature-header {
  display: flex;
  align-items: center;
  gap: 14px;
}

.feature-icon {
  flex-shrink: 0;
  width: 55px;
  height: 55px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon img {
  width: 55px;
  height: 55px;
  object-fit: contain;
}

.feature-title {
  font-weight: 400;
  font-size: 16px;
  line-height: 1.3;
  color: #1a1a1a;
}

.feature-description {
  font-size: 12px;
  font-weight: 200;
  color: #000;
  line-height: 1.5;
  margin-top: 5px;
}

.feature-subtext {
  font-size: 10px;
  color: #4a4a4a;
  line-height: 1.6;
}

/* Tablet */
@media screen and (max-width: 1200px) {
  .manufacturing-features-wrapper {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* Mobile slider */
@media screen and (max-width: 768px) {

  .manufacturing-features-wrapper {
    display: flex;
    overflow-x: auto;
    gap: 12px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;

    /* Hide scrollbar */
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .manufacturing-features-wrapper::-webkit-scrollbar {
    display: none;
  }

  .feature-card {
    min-width: 100%;
    scroll-snap-align: start;
  }

}

{% endstylesheet %}

<section class="manufacturing-features">
  <div class="page-width">

    <div class="manufacturing-features-wrapper" id="auto-feature-slider">

      {% for block in section.blocks %}

        <div class="feature-card" {{ block.shopify_attributes }}>

          <div class="feature-header">

            {% if block.settings.icon != blank %}
              <div class="feature-icon">
                <img
                  src="{{ block.settings.icon | image_url: width: 100 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}

            <div class="feature-title">
              {{ block.settings.title }}
            </div>

          </div>

          {% if block.settings.description != blank %}
            <div class="feature-description">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.subtext != blank %}
            <div class="feature-subtext">
              {{ block.settings.subtext }}
            </div>
          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>
</section>


<script>
document.addEventListener("DOMContentLoaded", function(){

  if(window.innerWidth <= 768){

    const slider = document.querySelector(".manufacturing-features-wrapper");
    const cards = slider.querySelectorAll(".feature-card");

    let index = 0;

    function autoSlide(){

      index++;

      if(index >= cards.length){
        index = 0;

        slider.scrollTo({
          left: 0,
          behavior: "smooth"
        });

      } else {

        slider.scrollTo({
          left: cards[index].offsetLeft,
          behavior: "smooth"
        });

      }

    }

    setInterval(autoSlide, 3000);

  }

});
</script>


