    "faq_image_YAq7kE": {
      "type": "faq-image",
      "blocks": {
        "faq_3JmTTh": {
          "type": "faq",
          "settings": {
            "question": "What makes Zyzven Naturals different?",
            "answer": "<p>We blend traditional herbal knowledge with modern manufacturing standards. Our formulas use botanical ingredients chosen for a purpose, and we're transparent about how and where they're made — so you know exactly what you're bringing into your routine.</p>",
            "open": false
          }
        },
        "faq_jBHKp9": {
          "type": "faq",
          "settings": {
            "question": "How are your products made and to what standards?",
            "answer": "<p>Our herbal teas are produced in BRCGS-certified UK facilities operating under HACCP and GMP principles, and our capsule formulations use standardized botanical extracts manufactured in GMP-compliant environments. Select products are independently third-party tested for purity and safety.</p>",
            "open": false
          }
        },
        "faq_EtrHgV": {
          "type": "faq",
          "settings": {
            "question": "Are your products natural, plant-based, and vegan?",
            "answer": "<p>Yes — our range is built around botanical, plant-based ingredients, and many products (such as our Pressure Balance capsules) are vegan and GMP-certified. Each product page lists its full ingredients so you can check before you buy.</p>",
            "open": false
          }
        },
        "faq_XhWk4P": {
          "type": "faq",
          "settings": {
            "question": "What kinds of products do you offer?",
            "answer": "<p>Herbal wellness teas, capsule supplements, wellness bundles, and natural skincare and personal care. Everything is organized by goal — women's wellness, metabolic health, heart health, digestion, blood sugar, kidney and urinary, joint and mobility, and more.</p>",
            "open": false
          }
        },
        "faq_UNhCUX": {
          "type": "faq",
          "settings": {
            "question": "How do I choose the right product for me?",
            "answer": "<p>Start with Shop by Goal, or take our 60-second wellness assessment for a tailored recommendation. If you're still unsure, reach out and we'll help you build a simple routine.</p>",
            "open": false
          }
        },
        "faq_AnJiFJ": {
          "type": "faq",
          "settings": {
            "question": "Are these products safe, and can I take them with medication?",
            "answer": "<p>Our products are formulated to support everyday wellness and are not intended to diagnose, treat, cure, or prevent any disease. If you're pregnant, nursing, taking medication, or managing a health condition, please consult your healthcare provider before use.</p>",
            "open": false
          }
        }
      },
