    "custom_liquid_NrNWWX": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Easy as 1. 2. 3.</title>\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: #fff; }\n\n  /* ============================================================\n     HOW IT WORKS / Easy as 1. 2. 3.\n     Scoped to #hiw so nothing leaks into other .section blocks.\n     Theme tokens are read with fallbacks so --pink / --cream win\n     when they exist.\n     ============================================================ */\n  #hiw {\n    --hiw-pink: var(--pink, #EC3A8C);\n    --hiw-cream: var(--cream, #F8F4EC);\n    --hiw-ink: var(--charcoal, #17171A);\n    --hiw-body: var(--gray-text, #5F6166);\n    --hiw-max: 940px;\n    --hiw-gap: 42px;\n    --hiw-radius: 28px;\n\n    padding: 56px 20px 72px;\n    background: linear-gradient(180deg, #FFFFFF 0%, var(--hiw-cream) 55%);\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Helvetica, Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  /* ---------- header ---------- */\n  #hiw .section-eyebrow {\n    margin: 0 0 14px;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n    color: var(--hiw-pink);\n    text-align: center;\n  }\n\n  #hiw .section-h2 {\n    margin: 0 auto 38px;\n    max-width: 20ch;\n    font-size: clamp(28px, 2.9vw, 34px);\n    font-weight: 800;\n    line-height: 1.15;\n    letter-spacing: -.022em;\n    color: var(--hiw-ink);\n    text-align: center;\n    text-wrap: balance;\n  }\n\n  /* ---------- grid ---------- */\n  #hiw .hiw-grid {\n    list-style: none;\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: var(--hiw-gap);\n    align-items: start;\n    max-width: var(--hiw-max);\n    margin: 0 auto;\n    padding: 0;\n  }\n\n  #hiw .hiw-step {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n  }\n\n  /* ---------- image ---------- */\n  #hiw .hiw-img {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    border-radius: var(--hiw-radius);\n    overflow: hidden;\n    background: #EFEAE1;\n    box-shadow: 0 2px 4px rgba(23,23,26,.04), 0 14px 34px -16px rgba(23,23,26,.22);\n    transition: transform .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s ease;\n  }\n\n  #hiw .hiw-img img {\n    position: absolute;\n    inset: 0;\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    transition: transform .8s cubic-bezier(.22,.61,.36,1);\n    will-change: transform;\n  }\n\n  #hiw .hiw-step:hover .hiw-img {\n    transform: translateY(-4px);\n    box-shadow: 0 3px 6px rgba(23,23,26,.05), 0 24px 46px -18px rgba(23,23,26,.28);\n  }\n\n  #hiw .hiw-step:hover .hiw-img img { transform: scale(1.04); }\n\n  /* ---------- number ---------- */\n  #hiw .hiw-num {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    flex: 0 0 44px;\n    margin: 18px 0 18px;\n    border-radius: 50%;\n    background: var(--hiw-pink);\n    color: #fff;\n    font-size: 18px;\n    font-weight: 800;\n    line-height: 1;\n    font-variant-numeric: tabular-nums;\n    box-shadow: 0 6px 16px -6px rgba(236,58,140,.55);\n  }\n\n  /* ---------- text ---------- */\n  #hiw .hiw-title {\n    margin: 0 0 10px;\n    font-size: 19px;\n    font-weight: 800;\n    line-height: 1.25;\n    letter-spacing: -.015em;\n    color: var(--hiw-ink);\n  }\n\n  #hiw .hiw-desc {\n    margin: 0;\n    font-size: 13.5px;\n    font-weight: 400;\n    line-height: 1.55;\n    color: var(--hiw-body);\n    text-wrap: pretty;\n  }\n\n  /* ---------- responsive ---------- */\n  @media (max-width: 1000px) {\n    #hiw { --hiw-gap: 30px; --hiw-radius: 24px; padding: 52px 18px 64px; }\n  }\n\n  @media (max-width: 780px) {\n    #hiw { --hiw-gap: 24px; }\n    #hiw .section-h2 { margin-bottom: 32px; }\n    #hiw .hiw-num { width: 40px; height: 40px; flex: 0 0 40px; margin: 16px 0 16px; font-size: 17px; }\n    #hiw .hiw-title { font-size: 18px; }\n    #hiw .hiw-desc { font-size: 13px; }\n  }\n\n  @media (max-width: 600px) {\n    #hiw {\n      --hiw-gap: 34px;\n      --hiw-radius: 22px;\n      padding: 44px 16px 56px;\n    }\n    #hiw .section-eyebrow { font-size: 12.5px; margin-bottom: 15px; }\n    #hiw .section-h2 { font-size: clamp(28px, 8.4vw, 34px); margin-bottom: 30px; }\n\n    #hiw .hiw-grid { grid-template-columns: 1fr; max-width: 380px; }\n    #hiw .hiw-num { margin: 16px 0 14px; }\n    #hiw .hiw-title { font-size: 19px; }\n    #hiw .hiw-desc { font-size: 14.5px; line-height: 1.5; max-width: 32ch; margin-inline: auto; }\n  }\n\n  @media (hover: none) {\n    #hiw .hiw-step:hover .hiw-img {\n      transform: none;\n      box-shadow: 0 2px 4px rgba(23,23,26,.04), 0 14px 34px -16px rgba(23,23,26,.22);\n    }\n    #hiw .hiw-step:hover .hiw-img img { transform: none; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hiw .hiw-img, #hiw .hiw-img img { transition: none !important; }\n    #hiw .hiw-step:hover .hiw-img { transform: none; }\n    #hiw .hiw-step:hover .hiw-img img { transform: none; }\n  }\n</style>\n</head>\n<body>\n\n<section class=\"section section-cream\" id=\"hiw\">\n  <p class=\"section-eyebrow\">How it works</p>\n  <h2 class=\"section-h2\">Easy as 1. 2. 3.</h2>\n\n  <ol class=\"hiw-grid\">\n\n    <li class=\"hiw-step\">\n      <div class=\"hiw-img\">\n        <img src=\"https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_620,h_620/v1778265157/ChatGPT_Image_May_8_2026_01_28_49_PM_jzjpsg.png\"\n             srcset=\"https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_320,h_320/v1778265157/ChatGPT_Image_May_8_2026_01_28_49_PM_jzjpsg.png 320w,\n                     https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_620,h_620/v1778265157/ChatGPT_Image_May_8_2026_01_28_49_PM_jzjpsg.png 620w\"\n             sizes=\"(max-width: 600px) 100vw, 285px\"\n             alt=\"Glukobalans capsules with a glass of water\" width=\"620\" height=\"620\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <div class=\"hiw-num\" aria-hidden=\"true\">1</div>\n      <h3 class=\"hiw-title\">Take</h3>\n      <p class=\"hiw-desc\">Take 1 capsule with a glass of water before each main meal. That's 3 a day.</p>\n    </li>\n\n    <li class=\"hiw-step\">\n      <div class=\"hiw-img\">\n        <img src=\"https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_620,h_620/v1778265164/ChatGPT_Image_May_8_2026_01_30_52_PM_mmogl6.png\"\n             srcset=\"https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_320,h_320/v1778265164/ChatGPT_Image_May_8_2026_01_30_52_PM_mmogl6.png 320w,\n                     https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_620,h_620/v1778265164/ChatGPT_Image_May_8_2026_01_30_52_PM_mmogl6.png 620w\"\n             sizes=\"(max-width: 600px) 100vw, 285px\"\n             alt=\"Balanced meal with Glukobalans\" width=\"620\" height=\"620\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <div class=\"hiw-num\" aria-hidden=\"true\">2</div>\n      <h3 class=\"hiw-title\">Eat</h3>\n      <p class=\"hiw-desc\">Enjoy balanced meals. The fibres and botanicals work alongside your food to keep you satisfied.</p>\n    </li>\n\n    <li class=\"hiw-step\">\n      <div class=\"hiw-img\">\n        <img src=\"https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_620,h_620/v1779311225/ChatGPT_Image_May_20_2026_02_42_08_PM_i7afhr.png\"\n             srcset=\"https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_320,h_320/v1779311225/ChatGPT_Image_May_20_2026_02_42_08_PM_i7afhr.png 320w,\n                     https://res.cloudinary.com/dss9cf62q/image/upload/f_auto,q_auto,c_fill,g_auto,w_620,h_620/v1779311225/ChatGPT_Image_May_20_2026_02_42_08_PM_i7afhr.png 620w\"\n             sizes=\"(max-width: 600px) 100vw, 285px\"\n             alt=\"Steady energy through the day\" width=\"620\" height=\"620\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <div class=\"hiw-num\" aria-hidden=\"true\">3</div>\n      <h3 class=\"hiw-title\">Stay consistent</h3>\n      <p class=\"hiw-desc\">Make it a daily habit. Steadier energy and fewer cravings come from consistency, not a quick fix.</p>\n    </li>\n\n  </ol>\n</section>\n\n</body>\n</html>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
