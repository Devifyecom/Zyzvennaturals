    "faq_quick_answers_XPDq6W": {
      "type": "faq-quick-answers",
      "blocks": {
        "question_WrtqwH": {
          "type": "question",
          "settings": {
            "question": "How fast will I notice a difference?",
            "answer": "<p>Everyone is different. Some customers notice fewer cravings in the first couple of weeks. For the full benefits, take Glukobalans daily for at least 4 to 6 weeks alongside a balanced diet and regular activity. Consistency matters more than any single day.</p>"
          }
        },
        "question_763NjP": {
          "type": "question",
          "settings": {
            "question": "How many capsules are in a bottle, and how long does it last?",
            "answer": "<p>Each bottle has 120 vegan capsules. At 3 capsules a day, that's a 40-day supply.</p>"
          }
        },
        "question_Ph3mWC": {
          "type": "question",
          "settings": {
            "question": "How and when should I take Glukobalans?",
            "answer": "<p>Take 3 capsules a day with a full glass of water. For best results, take one capsule before each main meal (breakfast, lunch and dinner). Don't exceed the recommended daily serving.</p>"
          }
        },
        "question_3X6eWL": {
          "type": "question",
          "settings": {
            "question": "What's in it?",
            "answer": "<p>Per 3-capsule serving: berberine HCl 600 mg, glucomannan (konjac root fibre) 570 mg, fenugreek seed extract 300 mg, gymnema sylvestre extract 180 mg, inulin (chicory root fibre) 135 mg, saffron extract 30 mg, Ceylon cinnamon extract 9 mg, black pepper extract (95% piperine) 6 mg and chromium (as chromium picolinate) 200 mcg. Every dose is on the label, with no proprietary blends.</p>"
          }
        },
        "question_JmN4pK": {
          "type": "question",
          "settings": {
            "question": "Does it contain caffeine or stimulants?",
            "answer": "<p>No. Glukobalans is completely stimulant-free: no caffeine, no green tea extract, no jitters. You can take it with your evening meal without affecting your sleep.</p>"
          }
        },
        "question_tqcgny": {
          "type": "question",
          "settings": {
            "question": "Is Glukobalans vegan and clean-label?",
            "answer": "<p>Yes. It's 100% vegan and non-GMO, with no artificial ingredients, in vegetable (HPMC) capsules. It's made in a GMP-certified facility and third-party tested, including for heavy metals, and a COA is available.</p>"
          }
        },
        "question_med01": {
          "type": "question",
          "settings": {
            "question": "Can I take Glukobalans with medication?",
            "answer": "<p>Berberine can interact with some medications, including glucose-lowering and blood pressure medicines. If you take any prescription medication or have a medical condition, talk to your doctor before starting Glukobalans. It isn't suitable during pregnancy or breastfeeding, or for children.</p>"
          }
        },
        "question_who01": {
          "type": "question",
          "settings": {
            "question": "Who is Glukobalans for?",
            "answer": "<p>Adults who want plant-based support for healthy glucose metabolism, steadier energy and fewer cravings, as part of a balanced diet and active lifestyle.<br/><br/><em>These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</em></p>"
          }
        }
      },
