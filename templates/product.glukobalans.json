    "custom_liquid_YfBRhU": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>3 Capsules. 4 Jobs.</title>\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: #fff; }\n\n  /* ============================================================\n     WHY IT WORKS / One Cup. Four Jobs.\n     Scoped to #hg-how so nothing leaks into other .section blocks.\n     Theme variables are used with fallbacks, so if --pink etc. are\n     defined on :root the theme values win.\n     ============================================================ */\n  #hg-how {\n    --hw-pink: var(--pink, #EC3A8C);\n    --hw-pink-soft: var(--pink-soft, #FCE7F1);\n    --hw-line: var(--gray-light, #EDEDF0);\n    --hw-body: var(--gray-text, #6E7075);\n    --hw-ink: var(--charcoal, #17171A);\n    --hw-max: 1160px;\n    --hw-gap: 18px;\n\n    padding: 64px 20px 72px;\n    background: #fff;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Helvetica, Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  #hg-how .hw-inner {\n    max-width: var(--hw-max);\n    margin: 0 auto;\n  }\n\n  /* ---------- header ---------- */\n  #hg-how .section-eyebrow {\n    margin: 0 0 14px;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n    color: var(--hw-pink);\n    text-align: center;\n  }\n\n  #hg-how .section-h2 {\n    margin: 0 auto 20px;\n    max-width: 20ch;\n    font-size: clamp(28px, 2.9vw, 34px);\n    font-weight: 800;\n    line-height: 1.15;\n    letter-spacing: -.022em;\n    color: var(--hw-ink);\n    text-align: center;\n    text-wrap: balance;\n  }\n\n  #hg-how .section-lead {\n    margin: 0 auto 34px;\n    max-width: 620px;\n    font-size: 17px;\n    font-weight: 400;\n    line-height: 1.5;\n    color: var(--hw-body);\n    text-align: center;\n    text-wrap: pretty;\n  }\n\n  /* ---------- card grid ---------- */\n  #hg-how .hw-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: var(--hw-gap);\n    align-items: stretch;\n    margin: 0 0 18px;\n  }\n\n  #hg-how .hw-card {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    background: #fff;\n    border: 1px solid var(--hw-line);\n    border-radius: 16px;\n    padding: 28px 20px 26px;\n    text-align: center;\n    box-shadow: 0 1px 2px rgba(18,18,18,.04), 0 10px 26px -14px rgba(18,18,18,.16);\n    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;\n  }\n\n  #hg-how .hw-card:hover {\n    transform: translateY(-3px);\n    border-color: color-mix(in srgb, var(--hw-pink) 22%, #fff);\n    box-shadow: 0 2px 4px rgba(18,18,18,.05), 0 20px 40px -18px rgba(236,58,140,.28);\n  }\n\n  #hg-how .hw-num {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    flex: 0 0 44px;\n    margin: 0 0 15px;\n    border-radius: 50%;\n    background: var(--hw-pink);\n    color: #fff;\n    font-size: 18px;\n    font-weight: 800;\n    line-height: 1;\n    font-variant-numeric: tabular-nums;\n  }\n\n  #hg-how .hw-card-title {\n    margin: 0 0 8px;\n    font-size: 16px;\n    font-weight: 800;\n    line-height: 1.3;\n    letter-spacing: -.012em;\n    color: var(--hw-ink);\n  }\n\n  #hg-how .hw-herbs {\n    margin: 0 0 12px;\n    font-size: 11px;\n    font-weight: 800;\n    line-height: 1.4;\n    letter-spacing: .085em;\n    text-transform: uppercase;\n    color: var(--hw-pink);\n  }\n\n  #hg-how .hw-copy {\n    margin: 0;\n    font-size: 13px;\n    font-weight: 400;\n    line-height: 1.55;\n    color: var(--hw-body);\n    text-wrap: pretty;\n  }\n\n  /* ---------- callout ---------- */\n  #hg-how .hw-callout {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: 28px 32px;\n    border-radius: 16px;\n    background: var(--hw-pink-soft);\n    text-align: center;\n  }\n\n  #hg-how .hw-callout p {\n    margin: 0;\n    font-size: 15px;\n    line-height: 1.6;\n    color: var(--hw-ink);\n    text-wrap: pretty;\n  }\n\n  #hg-how .hw-callout strong { font-weight: 700; }\n  #hg-how .hw-callout em { font-style: italic; }\n\n  /* ---------- CTA ---------- */\n  #hg-how .hw-cta {\n    margin-top: 20px;\n    text-align: center;\n  }\n\n  #hg-how .atc {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    width: 100%;\n    max-width: 300px;\n    min-height: 51px;\n    padding: 15px 28px;\n    border: 0;\n    border-radius: 999px;\n    background: var(--hw-pink);\n    color: #fff;\n    font-family: inherit;\n    font-size: 15.5px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    cursor: pointer;\n    box-shadow: 0 8px 24px -6px rgba(236,58,140,.45);\n    transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  #hg-how .atc:hover {\n    transform: translateY(-2px);\n    filter: brightness(1.04);\n    box-shadow: 0 14px 30px -8px rgba(236,58,140,.55);\n  }\n\n  #hg-how .atc:active {\n    transform: translateY(0);\n    box-shadow: 0 6px 16px -6px rgba(236,58,140,.45);\n  }\n\n  #hg-how .atc:focus-visible {\n    outline: 2px solid var(--hw-ink);\n    outline-offset: 3px;\n  }\n\n  #hg-how .atc svg {\n    width: 16px;\n    height: 16px;\n    flex: 0 0 16px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2.2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    transition: transform .22s ease;\n  }\n\n  #hg-how .atc:hover svg { transform: translateX(3px); }\n\n  /* ---------- responsive ---------- */\n  @media (max-width: 1080px) {\n    #hg-how { padding: 56px 18px 64px; }\n    #hg-how .hw-grid { gap: 14px; }\n    #hg-how .hw-card { padding: 26px 16px 24px; }\n  }\n\n  @media (max-width: 900px) {\n    #hg-how .hw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 20px; }\n    #hg-how .section-h2 { font-size: clamp(28px, 5vw, 32px); }\n    #hg-how .hw-callout { padding: 26px 24px; }\n  }\n\n  @media (max-width: 560px) {\n    #hg-how {\n      padding: 48px 16px 56px;\n      --hw-gap: 12px;\n    }\n    #hg-how .section-eyebrow { font-size: 12.5px; margin-bottom: 15px; }\n    #hg-how .section-h2 { font-size: clamp(28px, 8.4vw, 34px); max-width: 16ch; margin-bottom: 18px; }\n    #hg-how .section-lead { font-size: 16.5px; line-height: 1.55; max-width: 36ch; margin-bottom: 28px; }\n\n    #hg-how .hw-grid { grid-template-columns: 1fr; gap: 12px; margin-bottom: 18px; }\n    #hg-how .hw-card {\n      flex-direction: row;\n      align-items: flex-start;\n      gap: 16px;\n      padding: 20px 20px 21px;\n      text-align: left;\n    }\n    #hg-how .hw-num { width: 40px; height: 40px; flex: 0 0 40px; margin: 2px 0 0; font-size: 17px; }\n    #hg-how .hw-card-title { font-size: 17px; margin-bottom: 6px; }\n    #hg-how .hw-herbs { font-size: 11px; margin-bottom: 9px; }\n    #hg-how .hw-copy { font-size: 14px; line-height: 1.55; }\n\n    #hg-how .hw-callout { padding: 22px 20px; border-radius: 14px; }\n    #hg-how .hw-callout p { font-size: 15px; }\n    #hg-how .atc { max-width: none; font-size: 15px; }\n  }\n\n  @media (hover: none) {\n    #hg-how .hw-card:hover { transform: none; border-color: var(--hw-line); box-shadow: 0 1px 2px rgba(18,18,18,.04), 0 10px 26px -14px rgba(18,18,18,.16); }\n    #hg-how .atc:hover { transform: none; }\n    #hg-how .atc:hover svg { transform: none; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hg-how * { transition: none !important; }\n    #hg-how .hw-card:hover, #hg-how .atc:hover { transform: none; }\n  }\n</style>\n</head>\n<body>\n\n<section class=\"section\" id=\"hg-how\">\n  <div class=\"hw-inner\">\n\n    <p class=\"section-eyebrow\">Why it works</p>\n    <h2 class=\"section-h2\">3 Capsules. 4 Jobs.</h2>\n    <p class=\"section-lead\">Glukobalans isn't a single-ingredient pill. It's 9 ingredients chosen to work together, so every serving supports your metabolism from more than one angle.</p>\n\n    <ol class=\"hw-grid\" style=\"list-style:none;margin:0 0 18px;padding:0;\">\n      <li class=\"hw-card\">\n        <div class=\"hw-num\" aria-hidden=\"true\">1</div>\n        <div>\n          <h3 class=\"hw-card-title\">Supports glucose metabolism</h3>\n          <p class=\"hw-herbs\">Berberine HCl · Chromium</p>\n          <p class=\"hw-copy\">600 mg of berberine, the most studied plant compound for metabolic health, with chromium, which contributes to the maintenance of normal blood glucose levels.</p>\n        </div>\n      </li>\n\n      <li class=\"hw-card\">\n        <div class=\"hw-num\" aria-hidden=\"true\">2</div>\n        <div>\n          <h3 class=\"hw-card-title\">Takes the edge off cravings</h3>\n          <p class=\"hw-herbs\">Gymnema · Saffron</p>\n          <p class=\"hw-copy\">Gymnema, the Ayurvedic \"sugar destroyer\", is traditionally used to quiet a sweet tooth. Saffron is traditionally used to support mood and balanced eating.</p>\n        </div>\n      </li>\n\n      <li class=\"hw-card\">\n        <div class=\"hw-num\" aria-hidden=\"true\">3</div>\n        <div>\n          <h3 class=\"hw-card-title\">Keeps you satisfied</h3>\n          <p class=\"hw-herbs\">Glucomannan · Inulin</p>\n          <p class=\"hw-copy\">Konjac and chicory root fibres add bulk to your meals so you feel fuller for longer, and give your gut bacteria prebiotic support.</p>\n        </div>\n      </li>\n\n      <li class=\"hw-card\">\n        <div class=\"hw-num\" aria-hidden=\"true\">4</div>\n        <div>\n          <h3 class=\"hw-card-title\">Supports digestion &amp; absorption</h3>\n          <p class=\"hw-herbs\">Fenugreek · Ceylon Cinnamon · Black Pepper</p>\n          <p class=\"hw-copy\">Traditional metabolic botanicals, plus piperine from black pepper to help your body absorb the whole formula.</p>\n        </div>\n      </li>\n    </ol>\n\n    <div class=\"hw-callout\">\n      <p><strong>The difference:</strong> many blood sugar formulas hide behind proprietary blends and tiny doses. Glukobalans prints every dose on the label, leads with 600 mg of berberine, and is <em>completely stimulant-free</em>. You get steady support without the jitters.</p>\n    </div>\n\n    <div class=\"hw-cta\">\n      <button class=\"atc\" type=\"button\" onclick=\"hgBuy()\">\n        <span>Start my balance</span>\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 12h15M13 5.5 19.5 12 13 18.5\"/></svg>\n      </button>\n    </div>\n\n  </div>\n</section>\n\n<script>function hgBuy(){ /* theme handler */ }</script>\n\n</body>\n</html>",
