    "biab_founders_zhLUzX": {
      "type": "biab-founders",
      "name": "BIAB — Meet the founders",
      "settings": {
        "eyebrow": "Meet the Founders",
        "heading": "Built From the Ground Up by Shawnafi Dynesen & Lawrence Anderson",
        "story": "<p>Zyzven Naturals began with two people, a conviction that natural wellness should be accessible everywhere, and a great deal of patient work. Shawnafi and Lawrence built the brand from the ground up — formulating, sourcing, packing and shipping, learning every part of the business by doing it themselves.</p><p>Today, Zyzven Naturals serves customers across Jamaica, the USA, the UK, Sweden and Canada. The formulas in this box are the same ones sold on ZyzvenNaturals.com.</p><p>Now we are opening the doors to resellers and distributors: people who want to build something of their own, with products customers already know and ask for by name.</p>",
        "quote": "<p>When you partner with us, you're building with a family-founded brand, not a faceless supplier.</p>",
        "quote_attribution": "Shawnafi & Lawrence, Founders",
        "image": "shopify://shop_images/Image_6.jpg",
        "image_alt": "Zyzven Naturals founders Shawnafi and Lawrence with the Business in a Box reseller starter package"
      }
    },
