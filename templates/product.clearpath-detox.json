    "faq_quick_answers_feA6Xh": {
      "type": "faq-quick-answers",
      "blocks": {
        "question_xfnCfg": {
          "type": "question",
          "settings": {
            "question": "What is ClearPath Detox?",
            "answer": "<p>ClearPath is a short-term herbal cleansing tea formulated to support occasional bowel regularity, digestive comfort and a traditional parasite-cleanse wellness routine. It is not an everyday tea.</p>"
          }
        },
        "question_wiedPm": {
          "type": "question",
          "settings": {
            "question": "Does ClearPath kill or remove parasites?",
            "answer": "<p>ClearPath is not a medicine and is not intended to diagnose, treat or cure a parasitic infection. If you suspect parasites, seek appropriate testing and treatment from a healthcare professional.</p>"
          }
        },
        "question_AnLgde": {
          "type": "question",
          "settings": {
            "question": "What signs should I have medically checked?",
            "answer": "<p>Persistent diarrhea, severe abdominal pain, fever, blood in the stool, unexplained weight loss, dehydration or symptoms after travel should be assessed by a healthcare professional rather than self-treated with a cleanse.</p>"
          }
        },
        "question_LdCDxj": {
          "type": "question",
          "settings": {
            "question": "Does it contain senna?",
            "answer": "<p>Yes. The pack caution states that ClearPath contains senna, a stimulant-laxative herb intended for short-term occasional use. Do not use it continuously or more often than directed.</p>"
          }
        },
        "question_8R7BJD": {
          "type": "question",
          "settings": {
            "question": "How do I prepare it?",
            "answer": "<p>Use 1 tablespoon per cup, add freshly boiled water, cover and steep for 5-10 minutes, then strain. Follow the maximum frequency printed on your current pouch.</p>"
          }
        },
        "question_ddhPdU": {
          "type": "question",
          "settings": {
            "question": "When should I drink it?",
            "answer": "<p>Choose a time when you will have convenient bathroom access. For Zyzven's structured one-week routine, it is used every other evening, or in the morning for night-shift workers. Never exceed the package directions.</p>"
          }
        },
        "question_9Wff7e": {
          "type": "question",
          "settings": {
            "question": "Will it help me lose weight or belly fat?",
            "answer": "<p>ClearPath is not a fat-loss product. A laxative may temporarily change stool or body water, but this is not body-fat loss. Do not use the tea for rapid weight loss.</p>"
          }
        },
        "question_dHBYWy": {
          "type": "question",
          "settings": {
            "question": "Can it cause cramping or diarrhea?",
            "answer": "<p>Yes. Senna and rhubarb root may cause cramping, loose stools or diarrhea. Stop use if symptoms are severe or persistent, and replace lost fluids.</p>"
          }
        },
        "question_9M9MwR": {
          "type": "question",
          "settings": {
            "question": "Why is drinking water important?",
            "answer": "<p>Psyllium absorbs water and expands. Adequate fluid supports safe passage through the digestive tract and helps reduce the risk of choking, blockage and dehydration.</p>"
          }
        },
        "question_jgahqz": {
          "type": "question",
          "settings": {
            "question": "How should I store it?",
            "answer": "<p>Keep the pouch tightly sealed in a cool, dry place away from moisture and direct sunlight.</p>"
          }
        }
      },
