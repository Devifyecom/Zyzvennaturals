      "blocks": {
        "question_pbgiC8": {
          "type": "question",
          "settings": {
            "question": "What is Manthoric Advance designed for?",
            "answer": "<p>Manthoric Advance is a plant-based men's supplement made to support vitality, energy, stamina, physical performance and resilience to everyday stress, as part of an active lifestyle.</p>"
          }
        },
        "question_mJkCMq": {
          "type": "question",
          "settings": {
            "question": "How should I take it?",
            "answer": "<p>Take 2 capsules daily with a meal and a full glass of water. Don't exceed the recommended daily serving.</p>"
          }
        },
        "question_4HF6cx": {
          "type": "question",
          "settings": {
            "question": "How many capsules are in a bottle?",
            "answer": "<p>Each bottle contains 120 vegan capsules, a 60-day supply at 2 capsules a day.</p>"
          }
        },
        "question_time01": {
          "type": "question",
          "settings": {
            "question": "How long until I notice a difference?",
            "answer": "<p>Everyone is different. Adaptogens and botanicals build up over time, so we recommend taking Manthoric Advance daily for at least 6 to 8 weeks alongside regular training, good sleep and a balanced diet.</p>"
          }
        },
        "question_q9riDW": {
          "type": "question",
          "settings": {
            "question": "What's in it, and does it contain zinc?",
            "answer": "<p>Tongkat Ali, ashwagandha, black maca root, Panax ginseng, cordyceps mushroom, fenugreek, shilajit, moringa, zinc and black pepper extract. Yes, it contains zinc, which contributes to the maintenance of normal testosterone levels.</p>"
          }
        },
        "question_caff01": {
          "type": "question",
          "settings": {
            "question": "Does it contain caffeine or stimulants?",
            "answer": "<p>No caffeine. Manthoric Advance is built on adaptogens, traditional roots and zinc for steady daily support, not a short-lived buzz.</p>"
          }
        },
        "question_jtmUPH": {
          "type": "question",
          "settings": {
            "question": "Is Manthoric Advance vegan?",
            "answer": "<p>Yes. It's made with vegan capsules and contains no dairy, soy, gluten, fillers or artificial additives. GMP certified and third-party tested.</p>"
          }
        },
        "question_med01": {
          "type": "question",
          "settings": {
            "question": "Can I take it with medication?",
            "answer": "<p>Please check with your doctor first. Ingredients such as ashwagandha, ginseng and Tongkat Ali may interact with medications for blood pressure, blood sugar, thyroid, blood thinning or hormones, or with hormone-sensitive conditions.</p>"
          }
        },
        "question_DgrzGL": {
          "type": "question",
          "settings": {
            "question": "Who is this supplement for?",
            "answer": "<p>Adult men who want plant-based daily support for vitality, energy, stamina and stress resilience, especially those with busy schedules or active training routines.<br/><br/><em>These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</em></p>"
          }
        }
      },
