        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>What's inside — coverflow preview</title>\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: #fff; }\n\n  /* ============================================================\n     WHAT'S INSIDE — coverflow ring\n     Scoped to #hg-inside. The original CSS was scoped to #hg-pdp\n     while the section id is hg-how, so every rule here silently\n     depended on an unrelated ancestor existing.\n     ============================================================ */\n  #hg-inside {\n    --cf-pink: var(--pink, #EC2E8A);\n    --cf-pink-dark: var(--pink-dark, #D01F76);\n    --cf-pink-soft: var(--pink-soft, #FCE4EF);\n    --cf-ink: var(--charcoal, #17171A);\n    --cf-body: var(--gray-text, #5F6166);\n\n    --cf-card-w: 320px;\n    --cf-card-h: 476px;\n    --cf-radius: 20px;\n\n    padding: 40px 20px 0;\n    background: #fff;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Helvetica, Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  /* ---------- header ---------- */\n  #hg-inside .cf-eyebrow {\n    margin: 0 0 14px;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n    color: var(--cf-pink);\n    text-align: center;\n  }\n\n  #hg-inside .cf-heading {\n    margin: 0 auto 10px;\n    max-width: 24ch;\n    font-size: clamp(27px, 2.9vw, 34px);\n    font-weight: 800;\n    line-height: 1.15;\n    letter-spacing: -.022em;\n    color: var(--cf-ink);\n    text-align: center;\n    text-wrap: balance;\n  }\n\n  #hg-inside .cf-hint {\n    margin: 0;\n    font-size: 13.5px;\n    line-height: 1.5;\n    color: var(--cf-body);\n    text-align: center;\n  }\n\n  /* ---------- stage ---------- */\n  #hg-inside .hg-cf {\n    position: relative;\n    max-width: 1120px;\n    height: 530px;\n    margin: 22px auto 6px;\n    perspective: 1300px;\n  }\n\n  #hg-inside .hg-cf-stage {\n    position: absolute;\n    top: 26px;\n    left: 50%;\n    width: var(--cf-card-w);\n    height: var(--cf-card-h);\n    margin-left: calc(var(--cf-card-w) / -2);\n    transform-style: preserve-3d;\n    transition: transform .85s cubic-bezier(.34, 1, .64, 1);\n  }\n\n  #hg-inside .hg-cf-card {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: var(--cf-card-w);\n    height: var(--cf-card-h);\n    background: #fff;\n    border-radius: var(--cf-radius);\n    box-shadow: 0 18px 40px rgba(0, 0, 0, .22);\n    overflow: hidden;\n    cursor: pointer;\n    backface-visibility: hidden;\n    transition: opacity .6s ease;\n  }\n\n  #hg-inside .hg-cf-card img {\n    display: block;\n    width: 100%;\n    height: 240px;\n    object-fit: contain;\n    background: var(--cf-pink-soft);\n  }\n\n  #hg-inside .hg-cf-body {\n    padding: 18px 22px;\n    text-align: center;\n  }\n\n  #hg-inside .hg-cf-tag {\n    font-size: 13.5px;\n    font-weight: 800;\n    letter-spacing: .095em;\n    text-transform: uppercase;\n    line-height: 1.25;\n    color: var(--cf-pink);\n  }\n\n  #hg-inside .hg-cf-name {\n    margin: 6px 0 10px;\n    font-size: 18px;\n    font-weight: 800;\n    line-height: 1.2;\n    letter-spacing: -.012em;\n    color: var(--cf-ink);\n  }\n\n  #hg-inside .hg-cf-desc {\n    margin: 0;\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--cf-body);\n    text-wrap: pretty;\n  }\n\n  /* ---------- arrows ---------- */\n  #hg-inside .hg-cf-arrow {\n    position: absolute;\n    top: 178px;\n    z-index: 60;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 78px;\n    height: 78px;\n    padding: 0;\n    transform: translateY(-50%);\n    border: 3px solid #fff;\n    border-radius: 50%;\n    background: var(--cf-pink);\n    color: #fff;\n    cursor: pointer;\n    box-shadow: 0 12px 28px rgba(236, 46, 138, .55);\n    transition: background .15s ease, box-shadow .15s ease, transform .15s ease;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  #hg-inside .hg-cf-arrow:hover {\n    background: var(--cf-pink-dark);\n    transform: translateY(-50%) scale(1.08);\n    box-shadow: 0 14px 34px rgba(236, 46, 138, .65);\n  }\n\n  #hg-inside .hg-cf-arrow:active { transform: translateY(-50%) scale(1.02); }\n\n  #hg-inside .hg-cf-arrow:focus-visible {\n    outline: 3px solid var(--cf-ink);\n    outline-offset: 3px;\n  }\n\n  #hg-inside .hg-cf-arrow.prev { left: 4px; }\n  #hg-inside .hg-cf-arrow.next { right: 4px; }\n\n  #hg-inside .hg-cf-arrow svg {\n    width: 30px;\n    height: 30px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 3.4;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  /* ---------- CTA ---------- */\n  #hg-inside .cf-cta { margin-top: 26px; text-align: center; }\n\n  #hg-inside .atc {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    width: 100%;\n    max-width: 320px;\n    min-height: 56px;\n    padding: 16px 30px;\n    border: 0;\n    border-radius: 999px;\n    background: var(--cf-pink);\n    color: #fff;\n    font-family: inherit;\n    font-size: 16px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: .055em;\n    text-transform: uppercase;\n    cursor: pointer;\n    box-shadow: 0 10px 28px -6px rgba(236, 46, 138, .5);\n    transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;\n  }\n\n  #hg-inside .atc:hover {\n    transform: translateY(-2px);\n    filter: brightness(1.04);\n    box-shadow: 0 16px 34px -8px rgba(236, 46, 138, .6);\n  }\n\n  #hg-inside .atc:focus-visible { outline: 2px solid var(--cf-ink); outline-offset: 3px; }\n\n  #hg-inside .atc svg {\n    width: 17px; height: 17px; flex: 0 0 17px;\n    fill: none; stroke: currentColor; stroke-width: 2.2;\n    stroke-linecap: round; stroke-linejoin: round;\n    transition: transform .22s ease;\n  }\n\n  #hg-inside .atc:hover svg { transform: translateX(3px); }\n\n  /* ---------- tablet ---------- */\n  @media (max-width: 900px) {\n    #hg-inside { --cf-card-w: 280px; --cf-card-h: 456px; }\n    #hg-inside .hg-cf { height: 500px; }\n    #hg-inside .hg-cf-arrow { width: 60px; height: 60px; top: 160px; }\n    #hg-inside .hg-cf-arrow svg { width: 24px; height: 24px; }\n  }\n\n  /* ---------- mobile: flat snap scroller ---------- */\n  @media (max-width: 640px) {\n    #hg-inside { padding: 32px 0 0; }\n    #hg-inside .cf-eyebrow, #hg-inside .cf-heading, #hg-inside .cf-hint { padding-inline: 16px; }\n    #hg-inside .cf-heading { font-size: clamp(26px, 7.4vw, 32px); }\n\n    #hg-inside .hg-cf {\n      height: auto;\n      margin: 18px 0 6px;\n      perspective: none;\n    }\n\n    #hg-inside .hg-cf-stage {\n      position: static;\n      display: flex;\n      gap: 14px;\n      width: auto;\n      height: auto;\n      margin: 0;\n      padding: 6px 16px 18px;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      scroll-padding-inline: 16px;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      transform: none !important;\n      touch-action: pan-x pan-y;\n    }\n\n    #hg-inside .hg-cf-stage::-webkit-scrollbar { display: none; }\n\n    #hg-inside .hg-cf-card {\n      position: relative !important;\n      top: auto !important;\n      left: auto !important;\n      flex: 0 0 78%;\n      max-width: 300px;\n      height: auto;\n      transform: none !important;\n      opacity: 1 !important;\n      pointer-events: auto !important;\n      scroll-snap-align: center;\n      cursor: default;\n    }\n\n    #hg-inside .hg-cf-card[data-clone] { display: none; }\n\n    #hg-inside .hg-cf-card img { height: 210px; }\n    #hg-inside .hg-cf-body { padding: 16px 18px 22px; }\n    #hg-inside .hg-cf-tag { font-size: 12.5px; }\n    #hg-inside .hg-cf-name { font-size: 18px; }\n    #hg-inside .hg-cf-desc { font-size: 15px; }\n\n    #hg-inside .hg-cf-arrow {\n      top: 42%;\n      width: 44px;\n      height: 44px;\n      border-width: 2px;\n      box-shadow: 0 6px 16px rgba(236, 46, 138, .45);\n    }\n    #hg-inside .hg-cf-arrow svg { width: 18px; height: 18px; stroke-width: 3.2; }\n\n    #hg-inside .cf-cta { padding-inline: 16px; }\n    #hg-inside .atc { max-width: none; }\n  }\n\n  @media (hover: none) {\n    #hg-inside .hg-cf-arrow:hover { background: var(--cf-pink); transform: translateY(-50%); }\n    #hg-inside .atc:hover { transform: none; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #hg-inside .hg-cf-stage,\n    #hg-inside .hg-cf-card,\n    #hg-inside .hg-cf-arrow,\n    #hg-inside .atc { transition: none !important; }\n  }\n</style>\n</head>\n<body>\n\n<section id=\"hg-inside\">\n\n  <p class=\"cf-eyebrow\">What's inside</p>\n  <h2 class=\"cf-heading\">10 ingredients. One daily edge.</h2>\n  <p class=\"cf-hint\">Swipe or tap a card to explore the formula.</p>\n\n  <div class=\"hg-cf\" id=\"hgCf\" role=\"group\" aria-roledescription=\"carousel\" aria-label=\"Ingredients\">\n\n    <button class=\"hg-cf-arrow prev\" type=\"button\" aria-label=\"Previous ingredient\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 4.5 8 12l7 7.5\"/></svg>\n    </button>\n\n    <div class=\"hg-cf-stage\">\n\n      <article class=\"hg-cf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0483/6183/2598/files/ChatGPT_Image_Jun_19_2026_01_35_01_PM.png?v=1782157994&width=640\"\n             alt=\"Tongkat Ali, Fenugreek\" width=\"640\" height=\"480\" loading=\"lazy\" decoding=\"async\">\n        <div class=\"hg-cf-body\">\n          <p class=\"hg-cf-tag\">Vitality</p>\n          <h3 class=\"hg-cf-name\">Tongkat Ali · Fenugreek</h3>\n          <p class=\"hg-cf-desc\">Two traditional men's botanicals at the heart of the formula, for everyday vitality.</p>\n        </div>\n      </article>\n\n      <article class=\"hg-cf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0483/6183/2598/files/ChatGPT_Image_Jun_19_2026_01_36_25_PM.png?v=1782157996&width=640\"\n             alt=\"Ashwagandha\" width=\"640\" height=\"480\" loading=\"lazy\" decoding=\"async\">\n        <div class=\"hg-cf-body\">\n          <p class=\"hg-cf-tag\">Stress &amp; recovery</p>\n          <h3 class=\"hg-cf-name\">Ashwagandha</h3>\n          <p class=\"hg-cf-desc\">An Ayurvedic adaptogen traditionally used to support resilience to stress, energy and recovery.</p>\n        </div>\n      </article>\n\n      <article class=\"hg-cf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0483/6183/2598/files/ChatGPT_Image_Jun_19_2026_01_37_38_PM.png?v=1782157998&width=640\"\n             alt=\"Black Maca, Panax Ginseng\" width=\"640\" height=\"480\" loading=\"lazy\" decoding=\"async\">\n        <div class=\"hg-cf-body\">\n          <p class=\"hg-cf-tag\">Energy &amp; stamina</p>\n          <h3 class=\"hg-cf-name\">Black Maca · Panax Ginseng</h3>\n          <p class=\"hg-cf-desc\">Two classic roots traditionally used to support energy, stamina and performance.</p>\n        </div>\n      </article>\n\n      <article class=\"hg-cf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0483/6183/2598/files/ChatGPT_Image_Jun_19_2026_01_38_48_PM.png?v=1782158006&width=640\"\n             alt=\"Cordyceps, Shilajit\" width=\"640\" height=\"480\" loading=\"lazy\" decoding=\"async\">\n        <div class=\"hg-cf-body\">\n          <p class=\"hg-cf-tag\">Endurance</p>\n          <h3 class=\"hg-cf-name\">Cordyceps · Shilajit</h3>\n          <p class=\"hg-cf-desc\">A functional mushroom and a mineral-rich resin traditionally used to support endurance and vitality.</p>\n        </div>\n      </article>\n\n      <article class=\"hg-cf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0483/6183/2598/files/0308a96d-e768-4b26-9673-1f88c575f782.png?v=1782157993&width=640\"\n             alt=\"Moringa, Zinc, Black Pepper\" width=\"640\" height=\"480\" loading=\"lazy\" decoding=\"async\">\n        <div class=\"hg-cf-body\">\n          <p class=\"hg-cf-tag\">Nutrition &amp; hormones</p>\n          <h3 class=\"hg-cf-name\">Moringa · Zinc · Black Pepper</h3>\n          <p class=\"hg-cf-desc\">Nutrient-dense moringa, zinc for normal testosterone levels, and black pepper for absorption.</p>\n        </div>\n      </article>\n\n    </div>\n\n    <button class=\"hg-cf-arrow next\" type=\"button\" aria-label=\"Next ingredient\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 4.5 16 12l-7 7.5\"/></svg>\n    </button>\n  </div>\n\n  <div class=\"cf-cta\">\n    <button class=\"atc\" type=\"button\" onclick=\"hgBuy()\">\n      <span>Unlock my vitality</span>\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 5.5 19.5 12 13 18.5\"/></svg>\n    </button>\n  </div>\n\n</section>\n\n<script>\n(function () {\n  var root = document.getElementById('hgCf');\n  if (!root) return;\n\n  var stage = root.querySelector('.hg-cf-stage');\n  var prev = root.querySelector('.prev');\n  var next = root.querySelector('.next');\n  var mqMobile = window.matchMedia('(max-width: 640px)');\n  var mqCalm = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n  // Duplicate the real cards once so the ring reads as a full circle.\n  // Clones are hidden from assistive tech and from the mobile scroller.\n  var originals = [].slice.call(root.querySelectorAll('.hg-cf-card'));\n  originals.forEach(function (card) {\n    var clone = card.cloneNode(true);\n    clone.setAttribute('data-clone', '');\n    clone.setAttribute('aria-hidden', 'true');\n    stage.appendChild(clone);\n  });\n\n  var cards = [].slice.call(root.querySelectorAll('.hg-cf-card'));\n  var n = cards.length;\n  var step = 360 / n;\n  var rot = 0;\n  var active = 0;\n\n  function radius() {\n    return window.innerWidth <= 900 ? 440 : 520;\n  }\n\n  function norm(a) {\n    a %= 360;\n    if (a > 180) a -= 360;\n    if (a < -180) a += 360;\n    return a;\n  }\n\n  function apply() {\n    if (mqMobile.matches) return;\n    var r = radius();\n    stage.style.transform = 'translateZ(-' + r + 'px) rotateY(' + rot + 'deg)';\n    cards.forEach(function (c, i) {\n      var ang = Math.abs(norm(i * step + rot));\n      c.style.transform = 'rotateY(' + (i * step) + 'deg) translateZ(' + r + 'px)';\n      c.style.opacity = ang < 22 ? '1' : (ang < 58 ? '0.9' : (ang < 92 ? '0.45' : '0'));\n      c.style.pointerEvents = ang < 92 ? 'auto' : 'none';\n      c.style.zIndex = String(Math.round(200 - ang));\n      c.setAttribute('aria-hidden', ang < 22 && !c.hasAttribute('data-clone') ? 'false' : 'true');\n    });\n  }\n\n  function go(d) {\n    if (mqMobile.matches) {\n      var card = root.querySelector('.hg-cf-card');\n      var w = card ? card.getBoundingClientRect().width + 14 : 300;\n      stage.scrollBy({ left: d * w, behavior: mqCalm.matches ? 'auto' : 'smooth' });\n      return;\n    }\n    rot -= d * step;\n    active = ((active + d) % n + n) % n;\n    apply();\n  }\n\n  prev.addEventListener('click', function (e) { e.stopPropagation(); go(-1); });\n  next.addEventListener('click', function (e) { e.stopPropagation(); go(1); });\n\n  cards.forEach(function (c, i) {\n    c.addEventListener('click', function () {\n      if (mqMobile.matches) return;\n      var d = ((i - active) % n + n) % n;\n      if (d > n / 2) d -= n;\n      if (d !== 0) go(d);\n    });\n  });\n\n  // Keyboard: left/right when the carousel has focus\n  root.setAttribute('tabindex', '0');\n  root.addEventListener('keydown', function (e) {\n    if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }\n    if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }\n  });\n\n  // Swipe (desktop ring only; mobile uses native scrolling)\n  var sx = null;\n  root.addEventListener('touchstart', function (e) {\n    if (mqMobile.matches) return;\n    sx = e.touches[0].clientX;\n  }, { passive: true });\n\n  root.addEventListener('touchend', function (e) {\n    if (sx === null || mqMobile.matches) return;\n    var dx = e.changedTouches[0].clientX - sx;\n    if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);\n    sx = null;\n  }, { passive: true });\n\n  // Rebuild on breakpoint change so rotating a phone doesn't strand the ring\n  var resizeTimer;\n  window.addEventListener('resize', function () {\n    clearTimeout(resizeTimer);\n    resizeTimer = setTimeout(function () {\n      if (mqMobile.matches) {\n        stage.style.transform = '';\n        cards.forEach(function (c) { c.style.transform = ''; c.style.opacity = ''; c.style.zIndex = ''; });\n      } else {\n        apply();\n      }\n    }, 150);\n  });\n\n  apply();\n})();\n\nfunction hgBuy() { /* theme handler */ }\n</script>\n\n</body>\n</html>",
