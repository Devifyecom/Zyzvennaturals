    "faq_quick_answers_feA6Xh": {
      "type": "faq-quick-answers",
      "blocks": {
        "question_xfnCfg": {
          "type": "question",
          "settings": {
            "question": "Is Alki Detox a laxative?",
            "answer": "<p>No. Alki Detox is a gentle, non-laxative herbal tea formulated to support digestion and the body's natural elimination processes without harsh stimulant laxatives.</p>"
          }
        },
        "question_wiedPm": {
          "type": "question",
          "settings": {
            "question": "When is the best time to drink it?",
            "answer": "<p>We recommend enjoying one cup in the morning. If you have a sensitive stomach, take it after a light meal rather than on an empty stomach.</p>"
          }
        },
        "question_AnLgde": {
          "type": "question",
          "settings": {
            "question": "Can Alki Detox help with bloating?",
            "answer": "<p>The blend contains herbs traditionally used to support comfortable digestion, healthy fluid balance and relief from occasional bloating. Individual experiences vary.</p>"
          }
        },
        "question_LdCDxj": {
          "type": "question",
          "settings": {
            "question": "Does it contain caffeine?",
            "answer": "<p>No. Alki Detox is naturally caffeine-free.</p>"
          }
        },
        "question_ddhPdU": {
          "type": "question",
          "settings": {
            "question": "What does Alki Detox taste like? ",
            "answer": "<p>It has a full-bodied herbal flavor with refreshing spearmint and warm, earthy notes from ginger, turmeric and roots.</p>"
          }
        },
        "question_9Wff7e": {
          "type": "question",
          "settings": {
            "question": "How many servings are in one pouch?",
            "answer": "<p>Each 80-gram pouch provides approximately 40 initial servings when prepared using 2 grams per cup. The herbs may be re-steeped up to three times.</p>"
          }
        },
        "question_dHBYWy": {
          "type": "question",
          "settings": {
            "question": "How quickly will I notice a difference?",
            "answer": "<p>Every body and routine is different. Some customers notice digestive changes sooner, while others experience the best results through consistent use over time.</p>"
          }
        },
        "question_9M9MwR": {
          "type": "question",
          "settings": {
            "question": "Can I take it with medication?",
            "answer": "<p>If you take prescription medication or have a medical condition, consult your healthcare professional before use. This is especially important for blood pressure, thyroid and blood-sugar medications.</p>"
          }
        },
        "question_jgahqz": {
          "type": "question",
          "settings": {
            "question": "Can I use it during pregnancy or while breastfeeding?",
            "answer": "<p>Do not use during pregnancy or while breastfeeding unless approved by a qualified healthcare professional.</p>"
          }
        },
        "question_kKQFKh": {
          "type": "question",
          "settings": {
            "question": "Can I combine it with other Zyzven Naturals products?",
            "answer": "<p>Alki Detox can be incorporated into a wider wellness routine. Contact the Zyzven Naturals team through the website chat for product guidance based on your routine and medications.</p>"
          }
        }
      },
